RAILS_ENV=staging
TURISTACK_IMAGE=ghcr.io/organizacion/turistack:sha-inmutable
POSTGRES_USER=turistack_staging
POSTGRES_PASSWORD=reemplazar
POSTGRES_DB=turistack_staging
PLATFORM_NAME=Turistack Staging
PLATFORM_BASE_DOMAIN=staging.turistack.com
PLATFORM_HOST=staging.turistack.com
AUTH_HOST=auth.staging.turistack.com
CUSTOM_DOMAIN_CNAME_TARGET=tenants.staging.turistack.com
APP_PROTOCOL=https
CADDY_SITE_ADDRESSES=staging.turistack.com, auth.staging.turistack.com, agencia-uno.staging.turistack.com, agencia-dos.staging.turistack.com
SECRET_KEY_BASE=reemplazar
ACTIVE_RECORD_ENCRYPTION_KEY=reemplazar_con_una_clave_distinta
GOOGLE_CLIENT_ID=reemplazar
GOOGLE_CLIENT_SECRET=reemplazar
PLATFORM_ADMIN_GOOGLE_EMAILS=operador-staging@example.com
REDIS_URL=redis://redis:6379/0
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=reemplazar
SMTP_PASSWORD=reemplazar
SMTP_AUTH=plain
MAILER_FROM="Turistack Staging <no-reply@staging.turistack.com>"
ACTIVE_STORAGE_SERVICE=local
ENABLE_STAGING_DATA=true
STAGING_AGENCY_ONE_ADMIN_EMAIL=admin-uno@example.com
STAGING_AGENCY_TWO_ADMIN_EMAIL=admin-dos@example.com
VAPID_SUBJECT=mailto:soporte@turistack.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
