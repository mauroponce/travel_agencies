RAILS_ENV=production
TURISTACK_IMAGE=ghcr.io/organizacion/turistack:sha-inmutable
POSTGRES_USER=turistack
POSTGRES_PASSWORD=reemplazar
POSTGRES_DB=turistack_production
PLATFORM_NAME=Turistack
PLATFORM_BASE_DOMAIN=turistack.com
PLATFORM_HOST=turistack.com
AUTH_HOST=auth.turistack.com
CUSTOM_DOMAIN_CNAME_TARGET=tenants.turistack.com
APP_PROTOCOL=https
CADDY_SITE_ADDRESSES=turistack.com,auth.turistack.com
SECRET_KEY_BASE=reemplazar
ACTIVE_RECORD_ENCRYPTION_KEY=reemplazar_con_una_clave_distinta
GOOGLE_CLIENT_ID=reemplazar
GOOGLE_CLIENT_SECRET=reemplazar
PLATFORM_ADMIN_GOOGLE_EMAILS=operador@example.com
REDIS_URL=redis://redis:6379/0
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=reemplazar
SMTP_PASSWORD=reemplazar
SMTP_AUTH=plain
MAILER_FROM="Turistack <no-reply@turistack.com>"
ACTIVE_STORAGE_SERVICE=local
VAPID_SUBJECT=mailto:soporte@turistack.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Stage 1: leave disabled. Enable only after agent:finalize_hosts and wildcard DNS.
AGENT_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CADDY_ASK_SECRET=
AGENT_IMPORTS_PER_MINUTE=5
AGENT_SEARCHES_PER_MINUTE=20
AGENT_AI_CONCURRENCY=2

# Daily provider attempts per workspace, including retries; resets at workspace midnight.
AGENT_IMPORTS_PER_DAY=25
AGENT_SEARCHES_PER_DAY=100
