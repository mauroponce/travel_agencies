# Desarrollo local. No mezclar DATABASE_URL con ninguna variable DB_*.
RAILS_ENV=development
PLATFORM_NAME=Turistack
APP_PROTOCOL=http
APP_PORT=3000
PLATFORM_BASE_DOMAIN=lvh.me
PLATFORM_HOST=platform.lvh.me
AUTH_HOST=auth.lvh.me
CUSTOM_DOMAIN_CNAME_TARGET=tenants.lvh.me
SECRET_KEY_BASE=generar_con_bin_rails_secret
ACTIVE_RECORD_ENCRYPTION_KEY=generar_otra_clave_larga_independiente
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2

# PostgreSQL para ejecución nativa. Compose reemplaza DB_HOST por el servicio db.
DB_HOST=localhost
DB_PORT=5432
DB_USER=turistack
DB_PASSWORD=turistack
DB_NAME=turistack_development
REDIS_URL=redis://localhost:6379/0

# Google OAuth (el único método de autenticación).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PLATFORM_ADMIN_GOOGLE_EMAILS=
DEMO_GOOGLE_EMAIL=

# Correo.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=plain
MAILER_FROM="Turistack <no-reply@turistack.com>"

# Web Push. Generar con: bundle exec webpush generate_key
VAPID_SUBJECT=mailto:soporte@turistack.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Archivos. Usar local o s3.
ACTIVE_STORAGE_SERVICE=local
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Imagen usada solamente por los compose de staging/producción.
TURISTACK_IMAGE=ghcr.io/organizacion/turistack:sha-inmutable

# Turistack Agente: never commit a real API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AGENT_ENABLED=true
AGENT_IMPORTS_PER_MINUTE=5
AGENT_SEARCHES_PER_MINUTE=20
AGENT_AI_CONCURRENCY=2
# Required only for automatic TLS in staging/production.
CADDY_ASK_SECRET=

# Production uses turistack.com; keep lvh.me locally.
# See deploy/env.production.example and docs/despliegue-dominios.md.

# Daily provider attempts per workspace, including retries; resets at workspace midnight.
AGENT_IMPORTS_PER_DAY=25
AGENT_SEARCHES_PER_DAY=100
