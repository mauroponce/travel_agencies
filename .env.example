# Aplicación
RAILS_ENV=development
PLATFORM_NAME=Turistack
APP_HOST=localhost
APP_PROTOCOL=http
APP_URL=http://localhost:3000
PLATFORM_BASE_DOMAIN=lvh.me
PLATFORM_HOST=platform.lvh.me
AUTH_HOST=auth.lvh.me
CUSTOM_DOMAIN_CNAME_TARGET=tenants.lvh.me
# Producción: PLATFORM_BASE_DOMAIN=turistack.com, PLATFORM_HOST=turistack.com,
# AUTH_HOST=auth.turistack.com y CUSTOM_DOMAIN_CNAME_TARGET=tenants.turistack.com.
SECRET_KEY_BASE=generar_con_bin_rails_secret
ACTIVE_RECORD_ENCRYPTION_KEY=generar_otra_clave_larga_independiente
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2
FORCE_SSL=false

# PostgreSQL y Redis
DATABASE_URL=postgresql://turistack:turistack@localhost:5432/turistack_development
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=cambiar_por_clave_robusta
POSTGRES_USER=turistack
POSTGRES_DB=turistack_production
TURISTACK_IMAGE=ghcr.io/organizacion/turistack:latest

# Google OAuth (único método de autenticación)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PLATFORM_ADMIN_GOOGLE_EMAILS=
DEMO_GOOGLE_EMAIL=

# Correo
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=plain
MAILER_FROM="Turistack <no-reply@turistack.com>"

# Web Push. Generar con: bundle exec webpush generate_key
VAPID_SUBJECT=mailto:soporte@turistack.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Archivos. Usar local o s3.
ACTIVE_STORAGE_SERVICE=local
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
