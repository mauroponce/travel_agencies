<div class="page-heading"><div><div class="eyebrow">TRAZABILIDAD COMERCIAL</div><h1 class="page-title">Comisiones</h1><p class="subtitle">Importes congelados al confirmar cada venta atribuida.</p></div></div>
<div class="metric-grid"><% {"Devengadas" => "accrued", "Pendientes" => "payable", "Liquidadas" => "settled"}.each do |label, status| %><div class="metric"><span class="text-xs text-muted"><%= label %></span><div class="metric-number"><%= money(@totals[status].to_i) %></div></div><% end %></div>
<section class="card mt-5"><div class="table-wrap"><table><thead><tr><th>Reserva</th><th>Revendedor</th><th>Condición</th><th>Estado</th><th>Importe</th></tr></thead><tbody><% @entries.each do |entry| %><tr><td><%= link_to entry.reservation.code, entry.reservation, class: "font-bold text-teal" %></td><td><%= entry.reseller_membership.user.name %></td><td><%= entry.calculation_kind == "percentage" ? "#{entry.rule_snapshot['percentage']}%" : "Importe fijo" %></td><td><span class="pill pill-gray"><%= entry.status %></span></td><td class="font-black"><%= money(entry.amount_cents) %></td></tr><% end %></tbody></table></div><% if @entries.empty? %><div class="card-body text-center text-muted">Todavía no hay comisiones en este alcance.</div><% end %></section>
<% if current_role == "admin" %><section class="notice mt-5">Las reglas activas se administran por revendedor. La liquidación manual permanece deshabilitada hasta validar las políticas comerciales de cancelaciones y pagos.</section><% end %>
