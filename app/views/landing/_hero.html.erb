<section class="hero" id="top">
  <div class="mesh mesh-hero" aria-hidden="true"></div><div class="gridlines" aria-hidden="true"></div>
  <div class="wrap hero-head">
    <a class="pill" href="#acompanamiento" data-reveal><span class="pill-badge"><svg class="ic"><use href="#i-spark"></use></svg>Nuevo</span><span>Tu agencia, <b>conectada</b></span><svg class="ic pill-arrow"><use href="#i-arrow"></use></svg></a>
    <h1 data-reveal style="--d:60ms">Cada viaje, cada venta,<br><em>en un solo lugar.</em></h1>
    <p class="lede" data-reveal style="--d:120ms">Salidas, cupos, reservas, pasajeros, cobros y rendiciones en una sola plataforma. Conectá a tu agencia con revendedores y coordinadores, sin depender de planillas interminables.</p>
    <div class="cta-row" data-reveal style="--d:180ms"><a class="btn btn-lg btn-white" href="#tour">Ver cómo funciona</a><%= button_to auth_start_path, method: :post, data: { turbo: false }, class: "btn btn-lg btn-dark" do %>Ingresar con Google<svg class="ic" aria-hidden="true"><use href="#i-arrow"></use></svg><% end %></div>
    <% if Current.host_scope == "platform" && AgentWorkspace.self_signup_enabled? %>
      <div class="cta-row" data-reveal style="--d:210ms"><%= link_to "Crear mi web de agente", agent_onboarding_path, class: "btn btn-lg btn-white" %></div>
    <% end %>
    <div class="trust" data-reveal style="--d:240ms"><span class="faces" aria-hidden="true"><i class="face f1"><svg class="av-alt"><use href="#av-1"></use></svg></i><i class="face f2"><svg class="av-alt"><use href="#av-2"></use></svg></i><i class="face f3"><svg class="av-alt"><use href="#av-3"></use></svg></i></span><span><b>Administrador, revendedor y coordinador</b> trabajando conectados.</span></div>
  </div>
  <div class="hero-stage" id="heroStage"><div class="wrap"><div class="shot-fit"><div class="shot hero-shot" data-shot="1080x682" role="group" aria-label="Panel demostrativo de Turistack con selector de perfiles">
<div class="app" id="demoApp">
  <aside class="app-side">
    <div class="app-brand"><%= image_tag "/brand/logo_turistack.png", alt: "Turistack", width: 2172, height: 724, class: "turistack-logo" %><svg class="ic app-collapse"><use href="#i-chev"></use></svg></div>
    <div class="app-search"><svg class="ic"><use href="#i-search"></use></svg><span>Buscar...</span><kbd>⌘K</kbd></div>
    <p class="app-label">GENERAL</p>
    <ul class="app-nav" id="appNavigation">
      <li class="is-active"><svg class="ic"><use href="#i-grid"></use></svg>Panel general<b>4</b></li>
      <li><svg class="ic"><use href="#i-calendar"></use></svg>Salidas</li>
      <li><svg class="ic"><use href="#i-suitcase"></use></svg>Paquetes y ofertas</li>
      <li><svg class="ic"><use href="#i-ticket"></use></svg>Reservas</li>
      <li><svg class="ic"><use href="#i-users"></use></svg>Pasajeros</li>
    </ul>
    <p class="app-label">ADMINISTRACIÓN</p>
    <ul class="app-nav" id="appNavigationBottom">
      <li><svg class="ic"><use href="#i-money"></use></svg>Cobros y rendiciones<b>2</b></li>
      <li><svg class="ic"><use href="#i-layers"></use></svg>Comisiones</li>
      <li><svg class="ic"><use href="#i-route"></use></svg>Operación</li>
    </ul>
    <div class="app-quota">
      <div class="app-quota-top"><span>Ocupación total</span><span id="appSidePct">71%</span></div>
      <span class="app-quota-bar"><i id="appSideBar" style="width:71%"></i></span>
      <span class="app-quota-note" id="appSideNote">128 de 180 lugares · ejemplo</span>
    </div>
  </aside>
  <div class="app-main">
    <div class="app-top">
      <div class="app-topsearch"><svg class="ic"><use href="#i-search"></use></svg><span>Buscar viajes, reservas, personas...</span></div>
      <div class="app-clock"><b id="appTopTime">Turistack</b><small>Panel demostrativo · datos ilustrativos</small></div>
      <div class="app-user">
        <span class="app-bell"><svg class="ic"><use href="#i-bell"></use></svg><i></i></span>
        <span class="face lg f2"><svg class="av-alt"><use href="#av-3"></use></svg></span>
        <span class="app-who"><b>Agencia Demo</b><select data-action="change->landing#changeRole" id="demoRole" class="app-role-select" aria-label="Cambiar perfil de demostración"><option value="admin">Administrador ▾</option><option value="reseller">Revendedor ▾</option><option value="coordinator">Coordinador ▾</option></select></span>
      </div>
    </div>
    <div class="app-body">
      <div class="app-crumbs"><span>Agencia Demo</span><svg class="ic"><use href="#i-chev"></use></svg><span id="appCrumbRole">Administración</span><svg class="ic"><use href="#i-chev"></use></svg><b id="appCrumbTitle">Vista general</b></div>
      <div class="kpis">
        <div class="kpi"><span class="kpi-l" id="kpi1Label">Salidas activas</span><span class="kpi-v" id="kpi1Value">4</span><span class="chip" id="kpi1Chip">Próximos viajes</span><svg class="spark" viewBox="0 0 120 34" preserveAspectRatio="none"><path d="M0 28 C10 28 14 18 24 18 C34 18 38 24 48 24 C58 24 62 12 72 12 C82 12 86 17 96 17 C106 17 110 5 120 5"></path></svg></div>
        <div class="kpi"><span class="kpi-l" id="kpi2Label">Pasajeros confirmados</span><span class="kpi-v" id="kpi2Value">128</span><span class="chip" id="kpi2Chip">Sobre 180 lugares</span><svg class="spark s2" viewBox="0 0 120 34" preserveAspectRatio="none"><path d="M0 27 C10 27 14 20 24 20 C34 20 38 25 48 25 C58 25 62 15 72 15 C82 15 86 19 96 19 C106 19 110 7 120 7"></path></svg></div>
        <div class="kpi"><span class="kpi-l" id="kpi3Label">Cupos disponibles</span><span class="kpi-v" id="kpi3Value">52</span><span class="chip" id="kpi3Chip">Calculados por micro</span><svg class="spark s3" viewBox="0 0 120 34" preserveAspectRatio="none"><path d="M0 25 C14 20 16 27 26 19 C38 13 41 18 55 16 C69 13 77 22 91 13 C106 6 112 11 120 4"></path></svg></div>
      </div>
      <div class="chartcard">
        <div class="chartcard-head"><div><h4 id="appChartTitle">Reservas confirmadas por semana</h4><p id="appChartSubtitle">Últimas 12 semanas · datos de ejemplo</p></div><div class="chart-tools"><span class="seg"><i class="on">12s</i><i>6m</i><i>1a</i></span><span class="legend"><i class="d1"></i>Este período<i class="d2"></i>Anterior</span></div></div>
        <div class="chart"><svg viewBox="0 0 620 168" preserveAspectRatio="none" class="chart-svg" role="img" aria-label="Gráfico demostrativo de actividad de reservas"><defs><linearGradient id="lineStrokeNv" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="#ffb37a"/><stop offset="45%" stop-color="#ff7ea8"/><stop offset="100%" stop-color="#8f7cf7"/></linearGradient></defs><g class="chart-grid"><line x1="0" y1="24" x2="620" y2="24"/><line x1="0" y1="60" x2="620" y2="60"/><line x1="0" y1="96" x2="620" y2="96"/><line x1="0" y1="132" x2="620" y2="132"/></g><path class="chart-prev" d="M0,146 C52,143 78,133 130,130 C182,127 208,135 260,129 C312,123 338,108 390,104 C442,100 468,111 520,99 C572,87 596,80 620,75"/><path id="demoChartLine" class="chart-line" d="M0,132 C52,128 78,113 130,109 C182,105 208,117 260,107 C312,97 338,73 390,69 C442,65 468,81 520,63 C572,45 596,35 620,29" stroke="url(#lineStrokeNv)"/></svg><span class="chart-dot"></span><div class="tip chart-tip"><b id="chartTipDate">Última semana</b><span><i class="d1"></i><span id="chartTipMetric">Reservas</span><em id="chartTipValue">24</em></span><span><i class="d2"></i>Semana anterior<em id="chartTipPrev">19</em></span></div><div class="chart-x"><span>01 ago</span><span>22 ago</span><span>12 sep</span><span>03 oct</span><span>19 oct</span></div></div>
      </div>
      <div class="tablecard departure-table">
        <div class="tablecard-head"><h4 id="appTableTitle">Próximas salidas</h4><span class="ghostchip" id="appTableBadge">4 salidas</span></div>
        <div class="row rhead"><span id="col1">Destino</span><span id="col2">Fecha</span><span id="col3">Micro</span><span class="rnum" id="col4">Pasajeros</span><span id="col5">Ocupación</span><span class="rnum" id="col6">Estado</span></div>
        <div id="appRows">
          <div class="row"><span class="rname"><i class="dot c1"></i>Mendoza · Super Sale</span><span>28 oct</span><span>Micro 01</span><span class="rnum">38 / 45</span><span class="occupancy"><label>84% ocupado</label><span class="bar"><i style="width:84%"></i></span></span><span class="pill-status">Abierta</span></div>
          <div class="row"><span class="rname"><i class="dot c2"></i>Bariloche y sus lagos</span><span>04 nov</span><span>Micro 02</span><span class="rnum">29 / 45</span><span class="occupancy"><label>64% ocupado</label><span class="bar"><i style="width:64%"></i></span></span><span class="pill-status">Abierta</span></div>
          <div class="row"><span class="rname"><i class="dot c3"></i>Córdoba serrana</span><span>12 nov</span><span>Micro 03</span><span class="rnum">34 / 45</span><span class="occupancy"><label>76% ocupado</label><span class="bar"><i style="width:76%"></i></span></span><span class="pill-status">Abierta</span></div>
          <div class="row"><span class="rname"><i class="dot c4"></i>Mar del Plata</span><span>19 nov</span><span>Micro 04</span><span class="rnum">27 / 45</span><span class="occupancy"><label>60% ocupado</label><span class="bar"><i style="width:60%"></i></span></span><span class="pill-status">Abierta</span></div>
        </div>
      </div>
    </div>
  </div>
</div>
</div></div></div></div>
</section>
