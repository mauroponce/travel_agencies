<% content_for :title, "Turistack · Plataforma turística" %>
<% content_for :body_class, "turistack-landing" %>
<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "landing", "data-turbo-track": "reload" %>
<% end %>
<% content_for :head do %>
  <meta name="description" content="Conectá salidas, cupos, reservas, pasajeros, cobros y rendiciones de tu agencia con Turistack.">
<% end %>
<div data-controller="landing">
<%= render "icons" %>
<a class="skip" href="#main">Saltar al contenido</a>
<header class="nav" id="nav">
  <div class="nav-inner">
    <a class="brand" href="#top" aria-label="Turistack, ir al inicio"><%= image_tag "/brand/logo_turistack.png", alt: "Turistack", width: 2172, height: 724, class: "turistack-logo" %></a>
    <nav class="nav-links" aria-label="Navegación principal"><a href="#features" class="is-active">Producto</a><a href="#tour">Cómo funciona</a><a href="#proof">Para tu equipo</a><a href="#acompanamiento">Servicio</a></nav>
    <div class="nav-actions"><% if agent_signup_available? %><%= link_to "Registrarme", agent_onboarding_path, class: "btn btn-ghost" %><% else %><a class="btn btn-ghost" href="#tour"><svg class="ic"><use href="#i-play"></use></svg>Ver recorrido</a><% end %><%= button_to auth_start_path, method: :post, data: { turbo: false }, class: "btn btn-line login-button" do %>Ingresar con Google<% end %><button type="button" data-action="landing#toggleMenu" class="mobile-menu-button" id="menuButton" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobileMenu"><svg class="ic"><use href="#i-grid"></use></svg></button></div>
    <nav id="mobileMenu" class="mobile-menu" aria-label="Navegación móvil"><a href="#features">Producto</a><a href="#tour">Cómo funciona</a><a href="#proof">Para tu equipo</a><a href="#acompanamiento">Servicio personalizado</a><a href="#start">Comenzar</a><% if agent_signup_available? %><%= link_to "Crear mi cuenta", agent_onboarding_path %><% end %></nav>
  </div>
</header>
<main id="main">
<%= render "hero" %>
<%= render "features" %>
<%= render "tour" %>
<%= render "roles" %>
<%= render "service" %>
<%= render "start" %>
</main>
</div>
