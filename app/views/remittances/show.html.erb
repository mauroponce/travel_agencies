<div class="page-heading"><div><div class="eyebrow">RENDICIÓN</div><h1 class="page-title"><%= @remittance.code %></h1><p class="subtitle"><%= @remittance.reseller_membership.user.name %> · <%= l @remittance.declared_on %></p></div><span class="pill <%= @remittance.status == 'verified' ? 'pill-green' : 'pill-amber' %>"><%= @remittance.status.humanize %></span></div>
<div class="grid gap-5 lg:grid-cols-3"><section class="card card-body lg:col-span-2"><h2 class="font-black">Asignaciones</h2><div class="mt-4 space-y-3"><% @remittance.remittance_allocations.includes(customer_payment: :reservation).each do |allocation| %><div class="flex justify-between rounded-xl bg-slate-50 p-4"><span>Reserva <strong><%= allocation.customer_payment.reservation.code %></strong></span><strong><%= money(allocation.amount_cents) %></strong></div><% end %></div></section><aside class="card card-body"><div class="eyebrow">TOTAL DECLARADO</div><div class="mt-2 text-3xl font-black"><%= money(@remittance.amount_cents) %></div><p class="mt-3 text-sm text-muted"><%= @remittance.notes %></p><%= button_to "Confirmar recepción", verify_remittance_path(@remittance), method: :post, class: "btn btn-teal mt-5 w-full", data: {turbo_confirm: "¿Confirmás que la empresa recibió este dinero?"} if current_role == 'admin' && @remittance.status == 'declared' %></aside></div>
