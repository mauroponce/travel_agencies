<div class="page-heading"><div><div class="eyebrow">DINERO EN TRÁNSITO</div><h1 class="page-title">Rendiciones</h1><p class="subtitle">Diferenciamos lo cobrado, lo enviado y lo verificado por la empresa.</p></div></div>
<% if current_role == "reseller" %><section class="card card-body mb-5"><h2 class="font-black">Declarar una rendición</h2><%= form_with url: remittances_path, class: "mt-4 space-y-4" do |f| %><div class="grid gap-3 md:grid-cols-3"><div><%= f.label :method, "Medio" %><%= f.select :method, [["Efectivo", "cash"], ["Transferencia", "transfer"], ["Mercado Pago", "mercado_pago"], ["Otro", "other"]] %></div><div><%= f.label :declared_on, "Fecha" %><%= f.date_field :declared_on, value: Date.current %></div><div><%= f.label :proof, "Comprobante" %><%= f.file_field :proof, accept: "image/*,.pdf" %></div><div class="md:col-span-3"><%= f.label :notes, "Observaciones" %><%= f.text_field :notes %></div></div><div><h3 class="text-sm font-bold">Asignar cobros en pesos</h3><% @available_payments.each do |payment| %><div class="mt-2 grid grid-cols-[1fr_160px] items-center gap-3 rounded-xl bg-slate-50 p-3"><span><strong><%= payment.reservation.code %></strong> · pendiente <%= money(payment.pending_remittance_cents) %></span><%= number_field_tag "allocations[#{payment.id}]", nil, min: 0, max: money_input_value(payment.pending_remittance_cents), step: "0.01", placeholder: "ARS" %></div><% end %></div><%= f.submit "Declarar rendición", class: "btn btn-primary" %><% end %></section><% end %>
<section class="card"><div class="table-wrap"><table><thead><tr><th>Código</th><th>Revendedor</th><th>Fecha</th><th>Estado</th><th>Importe</th></tr></thead><tbody><% @remittances.each do |remittance| %><tr><td><%= link_to remittance.code, remittance, class: "font-bold text-teal" %></td><td><%= remittance.reseller_membership.user.name %></td><td><%= l remittance.declared_on %></td><td><span class="pill <%= remittance.status == 'verified' ? 'pill-green' : 'pill-amber' %>"><%= remittance.status.humanize %></span></td><td class="font-black"><%= money(remittance.amount_cents) %></td></tr><% end %></tbody></table></div></section>
