<div class="page-heading">
  <div><div class="eyebrow">OPERACIÓN DE PLATAFORMA</div><h1 class="page-title">Empresas y dominios</h1><p class="subtitle">Alta privada, suspensión y dominios autorizados.</p></div>
  <%= link_to "Nueva empresa", new_platform_company_path, class: "btn btn-primary" %>
</div>

<%= turbo_frame_tag "platform_companies" do %>
<div class="space-y-5">
  <% @companies.each do |company| %>
    <section class="card card-body">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div><h2 class="text-xl font-black"><%= company.name %></h2><p class="text-sm text-muted"><%= company.email %> · <%= company.memberships.size %> miembros</p></div>
        <%= form_with model: [:platform, company], method: :patch, class: "flex items-center gap-2" do |form| %>
          <%= form.select :status, [["Activa", "active"], ["Suspendida", "suspended"]], {}, class: "!w-auto", aria: { label: "Estado de #{company.name}" } %>
          <%= form.submit "Guardar", class: "btn" %>
        <% end %>
      </div>

      <div class="table-wrap mt-5"><table><thead><tr><th>Hostname</th><th>Tipo</th><th>Estado</th><th>TLS</th><th>Uso</th><th>Acciones</th></tr></thead><tbody>
        <% company.company_domains.sort_by(&:created_at).each do |domain| %>
          <tr>
            <td><strong><%= domain.hostname %></strong><% if domain.custom? %><small class="block text-muted">CNAME → <%= domain.cname_target %></small><% end %></td>
            <td><%= domain.platform_subdomain? ? "Plataforma" : "Propio" %></td><td><%= domain.status %></td><td><%= domain.tls_status %></td><td><%= domain.primary? ? "Principal" : "Alternativo" %></td>
            <td><div class="flex flex-wrap gap-2">
              <% if domain.custom? %><%= button_to(domain.active? ? "Reverificar" : "Verificar", verify_platform_company_company_domain_path(company, domain), class: "btn") %><% end %>
              <% if domain.status == "verified" && domain.tls_status == "ready" %><%= button_to "Activar", activate_platform_company_company_domain_path(company, domain), class: "btn" %><% end %>
              <% if domain.active? && !domain.primary? %><%= button_to "Hacer principal", make_primary_platform_company_company_domain_path(company, domain), class: "btn" %><% end %>
              <% if domain.custom? && domain.active? %><%= button_to "Deshabilitar", disable_platform_company_company_domain_path(company, domain), class: "btn" %><% end %>
            </div></td>
          </tr>
        <% end %>
      </tbody></table></div>

      <%= form_with model: [:platform, company, CompanyDomain.new], class: "mt-5 flex flex-wrap items-end gap-3" do |form| %>
        <div class="min-w-72 flex-1"><%= form.label :hostname, "Agregar dominio propio" %><%= form.text_field :hostname, placeholder: "app.cliente.com", required: true %></div>
        <%= form.submit "Registrar", class: "btn btn-primary" %>
      <% end %>
    </section>
  <% end %>
</div>
<%= render "shared/pagination", pagination: @companies_pagination, page_param: :page, frame_id: "platform_companies" %>
<% end %>
