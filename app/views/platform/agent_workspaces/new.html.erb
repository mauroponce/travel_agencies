<main class="mx-auto max-w-3xl p-6">
  <h1 class="text-3xl font-bold">Crear revendedor</h1>
  <%= render "agent/errors", record: @workspace %>
  <%= form_with model: @workspace, url: platform_agent_workspaces_path, class: "agent-form card p-6" do |f| %>
    <%= f.label :business_name, "Nombre comercial" %><%= f.text_field :business_name, required: true %>
    <%= f.label :public_name, "Nombre público" %><%= f.text_field :public_name, required: true %>
    <%= f.label :invited_email, "Correo de Google del revendedor" %><%= f.email_field :invited_email, required: true %>
    <%= f.label :subdomain, "Subdominio" %><%= f.text_field :subdomain, required: true %><small>.<%= PlatformHosts.base_domain %></small>
    <%= f.label :whatsapp, "WhatsApp comercial con código de país" %><%= f.telephone_field :whatsapp, required: true %>
    <p>Se enviará una invitación. El acceso requiere ingresar con esa cuenta de Google.</p>
    <%= f.submit "Crear y enviar invitación", class: "btn btn-primary" %>
  <% end %>
</main>
