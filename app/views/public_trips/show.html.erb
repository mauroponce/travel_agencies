<% content_for :title, "#{@offer.travel_package.name} · #{@offer.company.name}" %>
<% content_for :head do %><meta property="og:title" content="<%= @offer.travel_package.name %>"><meta property="og:description" content="<%= truncate(@offer.travel_package.description, length: 150) %>"><meta property="og:type" content="website"><meta property="og:url" content="<%= request.original_url %>"><% end %>
<div class="min-h-screen bg-surface" data-controller="availability" data-availability-url-value="<%= public_trip_status_path(@offer.company.slug, @offer.slug) %>">
  <header class="flex h-20 items-center justify-between border-b border-line bg-white px-5 lg:px-[max(2rem,calc((100vw-1180px)/2))]"><div class="brand !text-navy"><span class="brand-mark">↝</span><span>Turistack</span></div><span class="pill pill-gray"><%= @offer.company.name %></span></header>
  <section class="public-hero flex h-80 items-end px-5 pb-10 text-white lg:px-[max(2rem,calc((100vw-1180px)/2))]"><div><span class="pill bg-white/90 text-navy" data-availability-target="label"><%= @fare.promotion_label.presence || "VIAJE PUBLICADO" %></span><h1 class="mt-4 text-5xl font-black tracking-tight"><%= @offer.travel_package.destination.name %></h1><p class="mt-2"><%= @offer.travel_package.days %> días / <%= @offer.travel_package.nights %> noches · <%= @offer.accommodation.name %></p></div></section>
  <main class="mx-auto grid max-w-[1180px] gap-6 px-4 py-8 lg:grid-cols-[1.5fr_360px]">
    <div class="space-y-5"><section class="card card-body"><h2 class="text-xl font-black">Un viaje para disfrutar</h2><p class="mt-4 leading-7 text-slate-600"><%= @offer.travel_package.description %></p><div class="mt-5 flex flex-wrap gap-2"><span class="pill pill-gray">🚌 Micro ida y vuelta</span><span class="pill pill-gray">📅 <%= l @offer.departure.departs_at, format: :long %></span><span class="pill pill-gray">🏨 <%= @offer.travel_package.nights %> noches</span></div></section>
      <section class="card card-body"><h2 class="text-xl font-black">¿Qué incluye?</h2><ul class="mt-4 grid gap-3 md:grid-cols-2"><% @offer.travel_package.included_services.each do |service| %><li class="text-sm text-slate-600">✓ <%= service %></li><% end %></ul></section>
      <section class="card card-body"><h2 class="text-xl font-black">Alojamiento previsto</h2><div class="mt-4 rounded-xl bg-slate-50 p-4"><strong><%= @offer.accommodation.name %></strong><p class="mt-1 text-sm text-muted"><%= @offer.accommodation.address %></p><div class="mt-3 flex gap-2"><%= link_to "Google Maps", @offer.accommodation.maps_url, class: "btn", target: "_blank", rel: "noopener" if @offer.accommodation.maps_url.present? %><%= link_to "Sitio web", @offer.accommodation.website_url, class: "btn", target: "_blank", rel: "noopener" if @offer.accommodation.website_url.present? %></div></div></section>
      <section class="card card-body"><h2 class="text-xl font-black">Puntos de embarque</h2><div class="mt-4"><% @offer.departure.departure_stops.each do |stop| %><div class="flex justify-between border-b border-slate-100 py-4"><div><strong><%= stop.published_name %></strong><p class="text-xs text-muted"><%= stop.published_address %></p></div><strong><%= l stop.scheduled_at, format: :short %></strong></div><% end %></div></section>
      <section class="card card-body"><h2 class="text-xl font-black">Preguntas frecuentes</h2><% @offer.travel_package.faqs.each do |faq| %><details class="border-b border-slate-100 py-4"><summary class="cursor-pointer font-bold"><%= faq['question'] %></summary><p class="mt-3 text-sm leading-6 text-muted"><%= faq['answer'] %></p></details><% end %></section>
    </div>
    <aside class="card card-body h-fit lg:sticky lg:top-24"><div class="eyebrow">PRECIO POR PERSONA</div><div class="mt-3 text-4xl font-black" data-availability-target="price"><%= money(@fare.price_cents) %></div><p class="text-xs text-muted">+ <span data-availability-target="fee"><%= money(@fare.service_fee_cents) %></span> de gastos</p><div class="mt-5 rounded-xl bg-teal/10 p-4 font-black text-teal" data-availability-target="seats"><%= @offer.available_seats %> cupos disponibles</div><p class="mt-4 text-xs leading-5 text-muted">Consultar esta ficha no bloquea lugares. La disponibilidad siempre se verifica en el servidor al confirmar.</p><% message = ERB::Util.url_encode("Hola, quisiera consultar por #{@offer.travel_package.name}, salida #{l(@offer.departure.departs_at.to_date)}.") %><%= link_to "Consultar por WhatsApp", "https://wa.me/#{@contact_phone}?text=#{message}", class: "btn btn-teal mt-5 w-full", target: "_blank", rel: "noopener" if @contact_phone.present? %><p class="mt-3 text-center text-[10px] text-muted"><%= @reseller ? "Atención por revendedor autorizado" : "Atención por la empresa organizadora" %></p></aside>
  </main>
</div>
