<div class="page-heading"><div><div class="eyebrow">CATÁLOGO REUTILIZABLE</div><h1 class="page-title">Paquetes turísticos</h1><p class="subtitle">El contenido comercial se reutiliza en distintas fechas y salidas.</p></div><%= link_to "Nuevo paquete", new_travel_package_path, class: "btn btn-primary" %></div>
<%= turbo_frame_tag "travel_packages" do %><section class="card table-wrap"><table><thead><tr><th>Paquete</th><th>Destino</th><th>Duración</th><th></th></tr></thead><tbody><% @packages.each do |package| %><tr><td><strong><%= package.name %></strong></td><td><%= package.destination.name %></td><td><%= package.days %> días / <%= package.nights %> noches</td><td><%= link_to "Ver", package, class: "btn", data: { turbo_frame: "_top" } %></td></tr><% end %></tbody></table><%= render "shared/pagination", pagination: @packages_pagination, page_param: :page, frame_id: "travel_packages" %></section><% end %>
