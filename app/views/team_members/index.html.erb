<div class="page-heading"><div><div class="eyebrow">ACCESOS</div><h1 class="page-title">Equipo y revendedores</h1><p class="subtitle">Los permisos se activan únicamente al iniciar sesión con el email de Google invitado.</p></div></div>
<section class="card card-body"><h2 class="text-lg font-black">Invitar una persona</h2><%= form_with url: team_members_path, class: "mt-4 flex flex-wrap items-end gap-3" do |f| %><div class="min-w-64 flex-1"><%= f.label :email, "Email de Google" %><%= f.email_field :email, required: true %></div><% MembershipRole::ROLES.each do |role| %><label class="!mb-2 flex items-center gap-2"><%= check_box_tag "roles[]", role, role == "reseller", class: "!w-auto" %><%= role_label(role) %></label><% end %><%= f.submit "Enviar invitación", class: "btn btn-primary" %><% end %></section>
<section class="card mt-5"><div class="card-header"><h2 class="font-black">Miembros activos</h2></div><div class="table-wrap"><table><thead><tr><th>Persona</th><th>Perfiles</th><th>Contacto comercial en esta agencia</th><th>Estado / confianza</th></tr></thead><tbody><% @memberships.each do |membership| %><tr><td><strong><%= membership.user.name %></strong><small class="block text-muted"><%= membership.user.email %></small></td><td><%= membership.roles.map { |r| role_label(r) }.join(", ") %></td><td><%= membership.commercial_phone.presence || "Sin WhatsApp" %></td><td><%= form_with model: membership, url: team_member_path(membership), method: :patch, class: "flex flex-wrap items-center gap-2" do |f| %><%= f.select :status, [["Activo", "active"], ["Suspendido", "suspended"], ["Revocado", "revoked"]], {}, class: "!w-auto" %><%= f.telephone_field :commercial_phone, value: membership.commercial_phone, placeholder: "54911…", class: "!w-40", aria: { label: "WhatsApp comercial para #{membership.user.name} en #{current_company.name}" } %><% if membership.reseller_authorization %><label class="!mb-0 flex items-center gap-1"><%= f.check_box :auto_confirm_enabled, checked: membership.reseller_authorization.auto_confirm_enabled, class: "!w-auto" %><span class="text-xs">Autoconfirmar</span></label><% end %><%= f.submit "Guardar", class: "btn" %><% end %></td></tr><% end %></tbody></table></div></section>
<section class="card mt-5"><div class="card-header"><h2 class="font-black">Invitaciones recientes</h2></div><div class="card-body space-y-2"><% @invitations.each do |invitation| %><div class="flex justify-between rounded-xl bg-slate-50 p-3"><span><strong><%= invitation.email %></strong> · <%= invitation.roles.map { |r| role_label(r) }.join(", ") %></span><span class="pill <%= invitation.accepted_at ? 'pill-green' : 'pill-amber' %>"><%= invitation.accepted_at ? "Aceptada" : "Pendiente" %></span></div><% end %></div></section>
