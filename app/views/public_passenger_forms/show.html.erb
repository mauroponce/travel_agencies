<div class="min-h-screen bg-surface px-4 py-10"><main class="card card-body mx-auto max-w-2xl"><div class="eyebrow">FORMULARIO PRIVADO · NEXOVIAJES</div><h1 class="page-title">Datos del pasajero</h1><p class="subtitle"><%= @offer.travel_package.name %> · <%= @offer.company.name %>. Enviar estos datos no confirma una reserva ni ocupa un lugar.</p><%= form_with model: PassengerFormSubmission.new, url: public_passenger_form_path(params[:token]), class: "mt-6 form-grid" do |f| %><div class="field-wide"><%= f.label :full_name, "Nombre y apellido" %><%= f.text_field :full_name, value: @form.prefilled_name, required: true, autocomplete: "name" %></div><div><%= f.label :document_number, "DNI o documento" %><%= f.text_field :document_number, required: true, inputmode: "numeric" %></div><div><%= f.label :nationality, "Nacionalidad" %><%= f.text_field :nationality, value: "Argentina", required: true %></div><div><%= f.label :departure_stop_id, "Punto de embarque" %><%= f.collection_select :departure_stop_id, @offer.departure.departure_stops, :id, :published_name, prompt: "Seleccionar", required: true %></div><div><%= f.label :room_type, "Tipo de habitación" %><%= f.select :room_type, ["Doble", "Triple", "Cuádruple"], prompt: "Seleccionar" %></div><div class="field-wide"><%= f.label :notes, "Observaciones" %><%= f.text_area :notes, rows: 3 %></div><div class="field-wide"><%= f.submit "Enviar datos de forma segura", class: "btn btn-teal w-full" %></div><% end %><p class="mt-5 text-xs leading-5 text-muted">La información se cifra y solo puede verla el revendedor autorizado y la empresa organizadora.</p></main></div>
