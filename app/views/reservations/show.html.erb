<div class="page-heading"><div><div class="eyebrow">RESERVA</div><h1 class="page-title"><%= @reservation.code %></h1><p class="subtitle"><%= @reservation.departure_offer.travel_package.name %></p></div><span class="pill pill-green"><%= @reservation.status %></span></div><div class="grid gap-5 xl:grid-cols-2"><section class="card card-body"><h2 class="font-black">Pasajeros</h2><div class="mt-4 space-y-3"><% @reservation.passengers.each do |passenger| %><div class="rounded-xl bg-slate-50 p-4"><strong><%= passenger.full_name %></strong><p class="text-xs text-muted"><%= passenger.masked_document %> · <%= passenger.departure_stop.published_name %> · <%= passenger.accommodation.name %></p></div><% end %></div></section><section class="card card-body"><h2 class="font-black">Condición congelada</h2><dl class="mt-4 grid grid-cols-2 gap-4 text-sm"><div><dt class="text-muted">Precio unitario</dt><dd class="font-black"><%= money(@reservation.unit_price_cents) %></dd></div><div><dt class="text-muted">Gastos</dt><dd class="font-black"><%= money(@reservation.unit_fee_cents) %></dd></div><div><dt class="text-muted">Canal</dt><dd><%= @reservation.channel %></dd></div><div><dt class="text-muted">Rendición</dt><dd>Pendiente o verificada por separado</dd></div></dl><% if current_role == 'admin' && @reservation.status == 'confirmed' %><%= form_with url: cancel_reservation_path(@reservation), class: "mt-6 flex gap-2" do |form| %><%= text_field_tag :reason, nil, required: true, placeholder: "Motivo de cancelación" %><%= form.submit "Cancelar", class: "btn btn-danger" %><% end %><% end %></section></div>
