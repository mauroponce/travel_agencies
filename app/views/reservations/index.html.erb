<div class="page-heading"><div><div class="eyebrow">GESTIÓN DE CUPOS</div><h1 class="page-title"><%= current_role == 'reseller' ? 'Mis reservas' : 'Reservas' %></h1><p class="subtitle">La reserva, los pagos y la rendición mantienen estados separados.</p></div></div>
<%= turbo_frame_tag "reservations" do %><section class="card table-wrap"><table><thead><tr><th>Reserva</th><th>Viaje</th><th>Canal</th><th>Pasajeros</th><th>Estado</th><th></th></tr></thead><tbody><% @reservations.each do |reservation| %><tr><td><strong><%= reservation.code %></strong><small class="block text-muted"><%= l reservation.created_at, format: :short %></small></td><td><%= reservation.departure_offer.travel_package.name %></td><td><span class="pill pill-blue"><%= reservation.channel %></span></td><td><%= reservation.passengers.size %></td><td><span class="pill <%= reservation.status == 'confirmed' ? 'pill-green' : 'pill-gray' %>"><%= reservation.status %></span></td><td><%= link_to "Ver", reservation, class: "btn", data: { turbo_frame: "_top" } %></td></tr><% end %></tbody></table><%= render "shared/pagination", pagination: @reservations_pagination, page_param: :page, frame_id: "reservations" %></section><% end %>
