<% passenger = local_assigns[:passenger] %><div class="rounded-xl border border-line p-4" data-passenger><div class="mb-3 flex justify-between"><strong class="text-xs">PASAJERO</strong><button type="button" class="text-xs text-red-600" data-action="passengers#remove">Quitar</button></div><div class="form-grid"><div><%= label_tag "passengers_#{index}_full_name", "Nombre y apellido" %><%= text_field_tag "passengers[#{index}][full_name]", passenger&.full_name, required: true %></div><div><%= label_tag "passengers_#{index}_document_number", "DNI / documento" %><%= text_field_tag "passengers[#{index}][document_number]", passenger&.document_number, required: true %></div><div><%= label_tag "passengers_#{index}_nationality", "Nacionalidad" %><%= text_field_tag "passengers[#{index}][nationality]", passenger&.nationality || "Argentina" %></div><div><%= label_tag "passengers_#{index}_departure_stop_id", "Punto de embarque" %><%= select_tag "passengers[#{index}][departure_stop_id]", options_from_collection_for_select(offer.departure.departure_stops, :id, :published_name, passenger&.departure_stop_id) %></div><div><%= label_tag "passengers_#{index}_room_type", "Habitación" %><%= select_tag "passengers[#{index}][room_type]", options_for_select(%w[Doble Triple Cuádruple Individual], passenger&.room_type) %></div><div><%= label_tag "passengers_#{index}_notes", "Observaciones" %><%= text_field_tag "passengers[#{index}][notes]", passenger&.notes %></div></div></div>
