<div class="page-heading"><div><div class="eyebrow">CONFIRMACIÓN AUTOMÁTICA</div><h1 class="page-title">Nueva reserva</h1><p class="subtitle"><%= @offer.travel_package.name %> · <%= @offer.available_seats %> cupos disponibles</p></div></div>
<%= form_with url: reservations_path, class: "space-y-5", data: {controller: "passengers"} do |form| %><%= hidden_field_tag :departure_offer_id, @offer.id %><%= hidden_field_tag :passenger_form_id, @passenger_form&.id %><%= hidden_field_tag :idempotency_key, SecureRandom.uuid %><div class="notice">La confirmación descuenta lugares de inmediato. Una rendición pendiente no libera la reserva.</div><div class="card card-body"><div class="flex justify-between"><h2 class="font-black">Pasajeros</h2><button type="button" class="btn btn-soft" data-action="passengers#add">Agregar pasajero</button></div><div class="mt-4 space-y-4" data-passengers-target="container"><%= render "passenger_fields", index: 0, offer: @offer, passenger: @passenger_seed %></div><template data-passengers-target="template"><%= render "passenger_fields", index: "NEW_INDEX", offer: @offer, passenger: nil %></template></div><div class="card card-body"><h2 class="font-black">Pago declarado</h2><div class="form-grid mt-4"><div><%= label_tag "payment_amount_cents", "Importe (ARS)" %><%= number_field_tag "payment[amount_cents]", money_input_value(@offer.current_fare.required_payment_cents), min: "0.01", step: "0.01", required: true %></div><div><%= label_tag "payment_method", "Medio" %><%= select_tag "payment[method]", options_for_select([["Efectivo", "cash"], ["Transferencia", "transfer"], ["Mercado Pago", "mercado_pago"], ["Otro", "other"]]) %></div><div><%= label_tag "payment_received_on", "Fecha" %><%= date_field_tag "payment[received_on]", Date.current %></div><div><%= label_tag "payment_proof", "Comprobante" %><%= file_field_tag "payment[proof]", accept: "image/*,.pdf" %></div><div class="field-wide"><%= label_tag "payment_notes", "Observaciones" %><%= text_area_tag "payment[notes]" %></div></div></div><%= form.submit "Confirmar y ocupar cupos", class: "btn btn-teal" %><% end %>
