<div class="page-heading"><div><div class="eyebrow">MOVIMIENTOS DECLARADOS</div><h1 class="page-title"><%= current_role == 'reseller' ? 'Mis cobros' : 'Pagos de pasajeros' %></h1><p class="subtitle">El comprobante no equivale a una acreditación verificada.</p></div></div>
<section class="card"><div class="table-wrap"><table><thead><tr><th>Fecha</th><th>Reserva</th><th>Medio</th><th>Recibido por</th><th>Estado</th><th>Importe</th></tr></thead><tbody><% @payments.each do |payment| %><tr><td><%= l payment.received_on %></td><td><%= link_to payment.reservation.code, payment.reservation, class: "font-bold text-teal" %></td><td><%= payment.method.humanize %></td><td><%= payment.received_by_membership&.user&.name || "Empresa" %></td><td><span class="pill pill-gray"><%= payment.status.humanize %></span></td><td class="font-black"><%= money(payment.amount_cents) %></td></tr><% end %></tbody></table></div><% if @payments.empty? %><div class="card-body text-center text-muted">No hay pagos en este alcance.</div><% end %></section>
