<div class="app-shell">
  <aside class="sidebar">
    <%= link_to dashboard_path, class: "brand" do %><span class="brand-mark">↝</span><span><%= current_company.name %><small class="block text-[9px] tracking-[.2em] text-teal-300"><%= ENV.fetch("PLATFORM_NAME", "NexoViajes") %></small></span><% end %>
    <div class="workspace">
      <div class="text-xs font-extrabold text-white"><%= current_company.name %></div>
      <div class="mt-1 text-[11px] text-slate-400"><%= current_role.to_s.titleize %></div>
    </div>
    <nav class="mt-7 flex flex-col gap-1">
      <% navigation_items.each do |label, path, icon| %>
        <%= link_to path, class: "nav-link #{current_page?(path) ? 'nav-link-active' : ''}" do %><span><%= icon %></span><span><%= label %></span><% end %>
      <% end %>
    </nav>
    <div class="mt-auto border-t border-slate-700 pt-4 text-xs text-slate-400">
      <p>Datos protegidos por empresa y perfil.</p>
      <%= button_to "Cerrar sesión", session_path, method: :delete, class: "mt-3 text-slate-200" %>
    </div>
  </aside>
  <div class="main-column">
    <header class="topbar">
      <div><span class="text-xs text-slate-400">Workspace / </span><strong class="text-sm"><%= current_company.name %></strong></div>
      <div class="flex items-center gap-2">
        <%= form_with url: context_path, method: :post, class: "flex gap-2" do |form| %>
          <% roles = current_membership.roles.map { |role| [role_label(role), role] } %>
          <%= form.select :role, roles, {selected: current_role}, {class: "!w-auto max-w-56 !py-2", onchange: "this.form.requestSubmit()", aria: {label: "Cambiar perfil dentro de #{current_company.name}"}} %>
        <% end %>
        <%= link_to notifications_path, class: "btn", aria: {label: "Notificaciones"} do %>🔔<% end %>
        <span class="grid h-10 w-10 place-items-center rounded-xl bg-teal/10 text-xs font-black text-teal"><%= current_user.name.split.map(&:first).first(2).join %></span>
      </div>
    </header>
    <main class="content"><%= yield %></main>
  </div>
  <nav class="mobile-nav">
    <% navigation_items.first(5).each do |label, path, icon| %><%= link_to path do %><span class="text-xl"><%= icon %></span><span><%= label.split.first %></span><% end %><% end %>
  </nav>
</div>
