<% operator = current_role == "operator" %>
<% workspace_name = operator ? "Administración de plataforma" : current_company.name %>
<div class="app-shell cadence-shell" data-controller="app-shell" data-action="keydown@window->app-shell#handleKeydown">
  <aside id="main-sidebar" class="sidebar" data-app-shell-target="sidebar" aria-label="Menú principal">
    <div class="sidebar-logo">
      <%= link_to(operator ? platform_companies_path : dashboard_path, class: "sidebar-brand") do %>
        <%= image_tag "/icon.png", alt: "Turistack", width: 512, height: 512, class: "turistack-symbol" %>
        <span><%= image_tag "/brand/logo_turistack.png", alt: "Turistack", width: 2172, height: 724, class: "turistack-logo" %><small><%= workspace_name %></small></span>
      <% end %>
      <button class="sidebar-close" type="button" data-action="app-shell#close" aria-label="Cerrar menú"><%= app_icon("close") %></button>
    </div>

    <% navigation_sections.each do |section, items| %>
      <section class="sidebar-group" aria-labelledby="nav-<%= section.parameterize %>">
        <h2 id="nav-<%= section.parameterize %>" class="sidebar-label"><%= section %></h2>
        <nav class="sidebar-nav">
          <% items.each do |label, path, icon| %>
            <%= link_to path, class: "nav-link #{current_page?(path) ? 'nav-link-active' : ''}" do %>
              <%= app_icon(icon) %><span><%= label %></span>
              <% if label.include?("Reservas") && @metrics&.dig(:pending_reservations).to_i.positive? %>
                <span class="nav-count"><%= @metrics[:pending_reservations] %></span>
              <% elsif label == "Rendiciones" && @metrics&.dig(:pending_remittances).to_i.positive? %>
                <span class="nav-count"><%= @metrics[:pending_remittances] %></span>
              <% end %>
            <% end %>
          <% end %>
        </nav>
      </section>
    <% end %>

    <div class="sidebar-bottom">
      <div class="tenant-note"><strong><%= workspace_name %></strong><span><%= operator ? "Gestión de empresas y revendedores." : "Tu espacio de trabajo." %></span></div>
      <%= button_to session_path, method: :delete, class: "logout-button" do %><%= app_icon("log-out") %><span>Cerrar sesión</span><% end %>
    </div>
  </aside>

  <button class="sidebar-overlay" type="button" data-app-shell-target="overlay" data-action="app-shell#close" aria-label="Cerrar menú" tabindex="-1"></button>

  <div class="main-column">
    <header class="topbar">
      <button class="mobile-menu-button" type="button" data-action="app-shell#open" data-app-shell-target="toggle" aria-controls="main-sidebar" aria-expanded="false" aria-label="Abrir menú"><%= app_icon("menu") %></button>
      <div class="topbar-spacer" aria-hidden="true"></div>
      <div class="topbar-brand"><%= image_tag "/brand/logo_turistack.png", alt: "Turistack", width: 2172, height: 724, class: "turistack-logo" %><span><%= operator ? "Administración de plataforma" : "Panel de empresa" %></span></div>
      <div class="topbar-actions">
        <% if operator %>
          <div class="profile-switcher profile-static">
            <span class="profile-avatar"><%= current_user.name.split.map(&:first).first(2).join %></span>
            <span class="profile-copy"><strong><%= current_user.name %></strong><span>Operador</span></span>
          </div>
        <% else %>
        <%= link_to notifications_path, class: "topbar-icon-button", aria: {label: "Notificaciones"} do %><%= app_icon("bell") %><% end %>
        <%= form_with url: context_path, method: :post, class: "profile-switcher" do |form| %>
          <span class="profile-avatar"><%= current_user.name.split.map(&:first).first(2).join %></span>
          <span class="profile-copy"><strong><%= current_company.name %></strong><span><%= role_label(current_role) %></span></span>
          <% roles = current_membership.roles.map { |role| [role_label(role), role] } %>
          <%= form.select :role, roles, { selected: current_role }, { data: {action: "change->app-shell#submitForm"}, aria: {label: "Cambiar perfil dentro de #{current_company.name}"} } %>
        <% end %>
        <% end %>
      </div>
    </header>
    <main class="content"><%= yield %></main>
  </div>
</div>
