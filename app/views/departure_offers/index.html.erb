<div class="page-heading"><div><div class="eyebrow"><%= current_role == 'admin' ? 'OFERTA COMERCIAL' : 'VIAJES PARA VENDER' %></div><h1 class="page-title"><%= current_role == 'admin' ? 'Viajes publicados' : 'Catálogo de viajes' %></h1><p class="subtitle">Precios, hoteles y cupos actualizados desde la misma salida.</p></div><%= link_to "Nueva oferta", new_departure_offer_path, class: "btn btn-primary" if current_role == 'admin' %></div>
<%= turbo_frame_tag "offers" do %>
  <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3"><% @offers.each do |offer| %><article class="card overflow-hidden"><div class="public-hero h-44 p-5 text-white"><span class="pill bg-white/90 text-navy"><%= offer.status %></span><h2 class="mt-16 text-2xl font-black"><%= offer.travel_package.destination.name %></h2></div><div class="card-body"><p class="text-xs text-muted"><%= l offer.departure.departs_at, format: :short %> · <%= offer.travel_package.days %> días</p><h3 class="mt-2 text-lg font-black"><%= offer.travel_package.name %></h3><p class="mt-1 text-xs text-muted"><%= offer.accommodation.name %></p><% if (fare = offer.current_fare) %><div class="mt-5 text-2xl font-black"><%= money(fare.price_cents) %></div><small class="text-muted">+ <%= money(fare.service_fee_cents) %> de gastos</small><% end %><div class="mt-4 flex items-center justify-between"><strong class="text-teal"><%= offer.available_seats %> cupos</strong><%= link_to "Ver oferta", offer, class: "btn", data: { turbo_frame: "_top" } %></div></div></article><% end %></div>
  <%= render "shared/pagination", pagination: @offers_pagination, page_param: :page, frame_id: "offers" %>
<% end %>
