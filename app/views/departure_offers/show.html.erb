<div class="page-heading"><div><div class="eyebrow"><%= @offer.status.upcase %></div><h1 class="page-title"><%= @offer.travel_package.name %></h1><p class="subtitle"><%= @offer.accommodation.name %> · <%= l @offer.departure.departs_at, format: :long %></p></div><div class="flex gap-2"><%= link_to "Ficha pública", public_trip_path(@offer.company.slug, @offer.slug, ref: current_role == 'reseller' ? current_membership.reseller_authorization&.public_code : nil), target: "_blank", class: "btn" if @offer.status == 'published' %><%= link_to "Reservar", new_reservation_path(departure_offer_id: @offer.id), class: "btn btn-teal" if %w[admin reseller].include?(current_role) && @offer.status == 'published' %><% if current_role == 'admin' %><%= button_to(@offer.status == 'published' ? "Despublicar" : "Publicar", @offer.status == 'published' ? unpublish_departure_offer_path(@offer) : publish_departure_offer_path(@offer), class: "btn btn-primary") %><% end %></div></div>
<div class="grid gap-5 xl:grid-cols-[1.5fr_1fr]"><section class="card card-body"><h2 class="text-xl font-black">Detalle comercial</h2><p class="mt-3 leading-7 text-slate-600"><%= @offer.travel_package.description %></p><h3 class="mt-6 font-black">Servicios incluidos</h3><ul class="mt-3 grid gap-2 md:grid-cols-2"><% @offer.travel_package.included_services.each do |service| %><li class="text-sm text-slate-600">✓ <%= service %></li><% end %></ul></section><aside class="card card-body"><% if (fare = @offer.current_fare) %><div class="eyebrow"><%= fare.promotion_label.presence || 'PRECIO VIGENTE' %></div><div class="mt-3 text-4xl font-black"><%= money(fare.price_cents) %></div><p class="text-xs text-muted">+ <%= money(fare.service_fee_cents) %> de gastos</p><div class="mt-5 rounded-xl bg-teal/10 p-4 font-black text-teal"><%= @offer.available_seats %> cupos disponibles</div><% end %><% if current_role == 'admin' %><h3 class="mt-7 font-black">Actualizar precio</h3><%= form_with model: FareVersion.new, url: departure_offer_fare_versions_path(@offer), class: "mt-3 space-y-3" do |form| %><%= form.number_field :price_cents, placeholder: "Precio (ARS)", value: money_input_value(fare&.price_cents), min: 0, step: "0.01", required: true %><%= form.number_field :service_fee_cents, placeholder: "Gastos (ARS)", value: money_input_value(fare&.service_fee_cents), min: 0, step: "0.01" %><%= form.select :deposit_type, [["Seña", "fixed"], ["Pago completo", "full"]] %><%= form.number_field :deposit_cents, placeholder: "Seña mínima (ARS)", value: money_input_value(fare&.deposit_cents), min: 0, step: "0.01" %><%= form.text_field :promotion_label, placeholder: "Ej. SUPER SALE" %><%= form.submit "Guardar y notificar", class: "btn btn-primary w-full" %><% end %><% end %></aside></div>
