<%= form_with model: departure_offer, class: "card card-body space-y-5" do |form| %><% if departure_offer.errors.any? %><div class="notice notice-amber"><%= departure_offer.errors.full_messages.to_sentence %></div><% end %><div class="form-grid"><div><%= form.label :travel_package_id, "Paquete" %><%= form.collection_select :travel_package_id, current_company.travel_packages.order(:name), :id, :name %></div><div><%= form.label :departure_id, "Salida / micro" %><%= form.collection_select :departure_id, current_company.departures.order(:departs_at), :id, ->(d) { "#{d.code} · #{l(d.departs_at, format: :short)}" } %></div><div><%= form.label :accommodation_id, "Alojamiento" %><%= form.collection_select :accommodation_id, current_company.accommodations.order(:name), :id, :name %></div><div><%= form.label :slug, "Enlace público" %><%= form.text_field :slug, placeholder: "mendoza-super-sale" %></div></div><% unless departure_offer.persisted? %><fieldset class="rounded-xl border border-line p-4"><legend class="px-2 text-sm font-black">Tarifa inicial</legend><div class="form-grid"><div><%= label_tag "fare_price_cents", "Precio (ARS)" %><%= number_field_tag "fare[price_cents]", nil, min: 0, step: "0.01", required: true %></div><div><%= label_tag "fare_service_fee_cents", "Gastos (ARS)" %><%= number_field_tag "fare[service_fee_cents]", "0.00", min: 0, step: "0.01" %></div><div><%= label_tag "fare_deposit_type", "Condición" %><%= select_tag "fare[deposit_type]", options_for_select([["Seña", "fixed"], ["Pago completo", "full"]]) %></div><div><%= label_tag "fare_deposit_cents", "Seña mínima (ARS)" %><%= number_field_tag "fare[deposit_cents]", "0.00", min: 0, step: "0.01" %></div><div class="field-wide"><%= label_tag "fare_promotion_label", "Promoción" %><%= text_field_tag "fare[promotion_label]" %></div></div></fieldset><% end %><%= form.submit "Guardar oferta", class: "btn btn-teal" %><% end %>
