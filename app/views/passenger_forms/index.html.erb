<div class="page-heading"><div><div class="eyebrow">CAPTURA SEGURA</div><h1 class="page-title">Formularios privados</h1><p class="subtitle">Recibí datos sin ocupar cupos hasta confirmar la reserva.</p></div></div>
<% if @generated_url.present? %><div class="notice mb-5"><strong>Enlace listo para compartir</strong><div class="mt-2 flex gap-2"><input value="<%= @generated_url %>" readonly><%= link_to "Abrir", public_passenger_form_path(flash[:passenger_form_token]), class: "btn", target: "_blank", rel: "noopener" %></div></div><% end %>
<section class="card card-body"><h2 class="font-black">Nuevo formulario</h2><%= form_with url: passenger_forms_path, class: "mt-4 form-grid" do |f| %><div><%= f.label :departure_offer_id, "Viaje publicado" %><%= f.collection_select :departure_offer_id, current_company.departure_offers.published.includes(:travel_package), :id, ->(offer) { offer.travel_package.name }, prompt: "Seleccionar", required: true %></div><div><%= f.label :prefilled_name, "Nombre opcional" %><%= f.text_field :prefilled_name %></div><div class="field-wide"><%= f.submit "Generar enlace privado", class: "btn btn-primary" %></div><% end %></section>
<section class="card mt-5"><div class="table-wrap"><table><thead><tr><th>Viaje</th><th>Pasajero</th><th>Creado</th><th>Estado</th><th></th></tr></thead><tbody><% @forms.each do |form| %><tr><td><%= form.departure_offer.travel_package.name %></td><td><%= form.passenger_form_submission&.full_name || form.prefilled_name.presence || "—" %></td><td><%= l form.created_at, format: :short %></td><td><span class="pill <%= form.submitted_at ? 'pill-green' : 'pill-amber' %>"><%= form.reservation ? "Convertido" : (form.submitted_at ? "Recibido" : (form.available? ? "Esperando" : "Vencido")) %></span></td><td><%= link_to "Ver", passenger_form_path(form), class: "btn" if form.submitted_at %></td></tr><% end %></tbody></table></div></section>
