<% content_for :title, "Resumen · #{current_company.name}" %>
<% featured_offer = @offers.find { |offer| offer.current_fare&.promotion_label.present? } %>

<div class="dashboard-page">
  <nav class="dashboard-breadcrumb" aria-label="Ruta de navegación"><span><%= current_company.name %></span><%= app_icon("chevron") %><span><%= role_label(current_role) %></span><%= app_icon("chevron") %><strong>Resumen</strong></nav>

  <header class="dashboard-heading">
    <div>
      <span class="dashboard-eyebrow">Tu agencia, en una sola vista</span>
      <h1>Resumen general <span aria-hidden="true">↗</span></h1>
      <p>Controlá las ventas, los cupos y el dinero de tus próximos viajes.</p>
    </div>
    <div class="dashboard-heading-actions">
      <%= link_to notifications_path, class: "cadence-button secondary" do %><%= app_icon("bell") %>Notificaciones<% end %>
      <% if current_role == "admin" %>
        <%= link_to new_departure_offer_path, class: "cadence-button primary" do %><%= app_icon("plus") %>Nueva oferta<% end %>
      <% end %>
    </div>
  </header>

  <section class="dashboard-kpi-grid" aria-label="Indicadores operativos">
    <%= render "metric", label: "Salidas próximas", value: @metrics[:upcoming_departures], note: "En agenda", tone: "pink" %>
    <%= render "metric", label: "Pasajeros confirmados", value: @metrics[:confirmed_passengers], note: "Reservas confirmadas", tone: "violet" %>
    <%= render "metric", label: "Cupos por vender", value: @metrics[:available_seats], note: "Inventario compartido", tone: "blue" %>
    <%= render "metric", label: "Solicitudes pendientes", value: @metrics[:pending_reservations], note: "No ocupan cupos", tone: "orange" %>
  </section>

  <section class="dashboard-finance-grid" aria-label="Resumen financiero">
    <%= render "finance_card", label: "Cobros registrados", value: money(@metrics[:registered_payments_cents]), note: "Registrados · no equivale a dinero verificado", icon: "credit-card", tone: "coral" %>
    <%= render "finance_card", label: "Pendiente de rendir", value: money(@metrics[:pending_remittance_cents]), note: "Saldo no asignado de cobros de revendedores", icon: "send", tone: "violet" %>
    <%= render "finance_card", label: "Rendiciones por verificar", value: safe_join([@metrics[:pending_remittances].to_s, tag.span(" · #{money(@metrics[:pending_verification_cents])}")]), note: "Declaradas · recepción sin verificar", icon: "clock", tone: "orange" %>
  </section>

  <div class="dashboard-primary-grid">
    <section class="dashboard-panel dashboard-section dashboard-occupancy-panel" aria-labelledby="occupancy-title">
      <div class="dashboard-section-head">
        <div><h2 id="occupancy-title">Ocupación de próximas salidas</h2><p>Datos reales por salida operativa; cada micro se cuenta una sola vez.</p></div>
        <span class="dashboard-status purple"><%= pluralize(@occupancy_departures.size, "salida", "salidas") %></span>
      </div>
      <% if @occupancy_departures.any? %>
        <div class="dashboard-occupancy-chart" role="img" aria-label="Porcentaje de ocupación de las próximas salidas">
          <% @occupancy_departures.each do |departure| %>
            <% occupancy = occupancy_percentage(departure) %>
            <div class="dashboard-chart-row">
              <span title="<%= departure.code %>"><%= departure.code %></span>
              <div class="dashboard-chart-track"><i style="width: <%= occupancy %>%"></i></div>
              <strong><%= occupancy %>%</strong>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="dashboard-empty">Todavía no hay salidas próximas para graficar.</div>
      <% end %>
      <footer class="dashboard-chart-footer"><span><i></i>Ocupados sobre capacidad informada</span><span>Sin proyecciones ni tendencias ficticias</span></footer>
    </section>

    <section class="dashboard-panel dashboard-section dashboard-attention" aria-labelledby="attention-title">
      <div class="dashboard-section-head"><div><h2 id="attention-title">Necesita tu atención</h2><p>Prioridades operativas y administrativas</p></div></div>
      <%= link_to remittances_path, class: "dashboard-attention-item" do %><span class="dashboard-attention-icon coral"><%= app_icon("send") %></span><span><strong><%= pluralize(@metrics[:pending_remittances], "rendición", "rendiciones") %> por verificar</strong><small><%= money(@metrics[:pending_verification_cents]) %> · declaración pendiente de control</small></span><%= app_icon("arrow") %><% end %>
      <%= link_to reservations_path, class: "dashboard-attention-item" do %><span class="dashboard-attention-icon orange"><%= app_icon("ticket") %></span><span><strong><%= pluralize(@metrics[:pending_reservations], "solicitud", "solicitudes") %> sin confirmar</strong><small>Todavía no ocupan lugar en los micros</small></span><%= app_icon("arrow") %><% end %>
      <% if @attention_departure %>
        <%= link_to dashboard_path(departure_filter: "low", anchor: "departures"), class: "dashboard-attention-item" do %><span class="dashboard-attention-icon violet"><%= app_icon("bus") %></span><span><strong><%= @attention_departure.code %>, revisar cupos</strong><small><%= pluralize(@attention_departure.available_seats, "cupo disponible", "cupos disponibles") %> en <%= @attention_departure.bus.name %></small></span><%= app_icon("arrow") %><% end %>
      <% end %>
      <div class="dashboard-connected"><%= app_icon("spark") %><p><strong>Todo conectado.</strong> Una salida actualiza el inventario de todas las ofertas que comparten su micro.</p></div>
    </section>
  </div>

  <div class="dashboard-secondary-grid">
    <section id="departures" class="dashboard-panel dashboard-section dashboard-departures" aria-labelledby="departures-title">
      <div class="dashboard-section-head">
        <div><h2 id="departures-title">Próximas salidas</h2><p>Cupos compartidos entre todas las ofertas del mismo micro</p></div>
        <%= form_with url: dashboard_path(anchor: "departures"), method: :get, class: "dashboard-filter" do |form| %>
          <%= form.label :departure_filter, "Filtrar salidas", class: "sr-only" %>
          <%= form.select :departure_filter, [["Todas las salidas", "all"], ["Próximos 30 días", "month"], ["Cupos bajos", "low"]], {selected: @departure_filter}, {data: {action: "change->app-shell#submitForm"}} %>
        <% end %>
      </div>
      <% if @departures.any? %>
        <div class="dashboard-table-scroll" role="region" aria-label="Tabla de próximas salidas" tabindex="0">
          <table class="dashboard-table">
            <thead><tr><th>Salida / micro</th><th>Fecha</th><th>Ocupación</th><th>Disponibles</th><th>Estado</th><th><span class="sr-only">Acciones</span></th></tr></thead>
            <tbody><%= render partial: "departure_row", collection: @departures, as: :departure %></tbody>
          </table>
        </div>
      <% else %>
        <div class="dashboard-empty">No hay salidas dentro de este filtro.</div>
      <% end %>
      <footer class="dashboard-table-footer">
        <span>Mostrando <%= @departures.size %> de <%= @departure_result_count %> salidas del filtro · máximo <%= @departure_list_limit %></span>
        <%= link_to departures_path, class: "dashboard-text-link" do %>Ver todas<%= app_icon("arrow") %><% end %>
      </footer>
    </section>

    <div class="dashboard-right-stack">
      <section class="dashboard-panel dashboard-section" aria-labelledby="reservations-title">
        <div class="dashboard-section-head compact"><div><h2 id="reservations-title">Reservas recientes</h2><p>Estado comercial, separado de cobros y rendiciones</p></div><%= link_to reservations_path, class: "dashboard-text-link" do %>Ver todas<%= app_icon("arrow") %><% end %></div>
        <% if @reservations.any? %><div class="dashboard-reservation-list"><%= render partial: "reservation", collection: @reservations, as: :reservation %></div><% else %><div class="dashboard-empty">Todavía no hay reservas.</div><% end %>
      </section>

      <% if featured_offer %>
        <section class="dashboard-promo" aria-labelledby="promo-title">
          <span><%= featured_offer.current_fare.promotion_label %> · Oferta destacada</span>
          <h2 id="promo-title"><%= featured_offer.travel_package.name %></h2>
          <p><%= pluralize(featured_offer.departure.available_seats, "lugar libre", "lugares libres") %> en la salida <%= featured_offer.departure.code %> · desde <strong><%= money(featured_offer.current_fare.price_cents) %></strong>.</p>
          <%= link_to departure_offer_path(featured_offer), class: "dashboard-text-link" do %>Gestionar oferta<%= app_icon("arrow") %><% end %>
        </section>
      <% end %>
    </div>
  </div>

  <p class="dashboard-footnote">Indicadores calculados con el alcance completo autorizado. Los listados recientes y el gráfico muestran solamente los límites indicados.</p>
</div>
