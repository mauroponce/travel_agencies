<div class="page-heading"><div><div class="eyebrow"><%= current_role == 'admin' ? 'PANEL DE EMPRESA' : role_label(current_role).upcase %></div><h1 class="page-title">Buen día, <%= current_user.name.split.first %></h1><p class="subtitle">Todo lo que pasa en <%= current_company.name %>, en una sola pantalla.</p></div><div class="flex gap-2"><%= link_to "Notificaciones", notifications_path, class: "btn" %><%= link_to "Crear oferta", new_departure_offer_path, class: "btn btn-primary" if current_role == 'admin' %></div></div>
<div class="metric-grid">
  <div class="metric"><span class="text-xs font-semibold text-muted">Salidas activas</span><div class="metric-number"><%= @departures.size %></div><small class="text-teal">Itinerarios próximos</small></div>
  <div class="metric"><span class="text-xs font-semibold text-muted">Pasajeros confirmados</span><div class="metric-number"><%= @reservations.sum { |r| r.passengers.size } %></div><small class="text-muted">En tu alcance actual</small></div>
  <div class="metric"><span class="text-xs font-semibold text-muted">Cupos por vender</span><div class="metric-number"><%= @departures.sum(&:available_seats) %></div><small class="text-muted">Calculados en tiempo real</small></div>
  <div class="metric"><span class="text-xs font-semibold text-muted">Rendiciones pendientes</span><div class="metric-number"><%= @pending_remittances.count %></div><small class="text-orange"><%= money(@pending_remittances.sum(:amount_cents)) %></small></div>
</div>
<div class="mt-5 grid gap-5 xl:grid-cols-[1.6fr_1fr]">
  <div class="space-y-5">
    <% if (featured = @offers.find { |offer| offer.current_fare&.promotion_label.present? }) %>
      <section class="hero-gradient relative overflow-hidden rounded-2xl p-7 text-white"><span class="pill bg-orange text-navy"><%= featured.current_fare.promotion_label %></span><h2 class="mt-4 text-3xl font-black">Completá los últimos lugares.</h2><p class="mt-2 text-slate-200"><%= featured.travel_package.name %> desde <strong><%= money(featured.current_fare.price_cents) %></strong>.</p><%= link_to "Ver ficha pública", public_trip_path(featured.company.slug, featured.slug), class: "btn mt-5", target: "_blank" %></section>
    <% end %>
    <section class="card"><div class="card-header"><div><h2 class="font-black">Próximas salidas</h2><p class="text-xs text-muted">Cupos compartidos entre paquetes del mismo micro</p></div><%= link_to "Ver todas", departures_path, class: "btn" %></div><div class="card-body space-y-4"><% @departures.each do |departure| %><div class="flex items-center justify-between border-b border-slate-100 pb-4"><div><strong><%= departure.code %></strong><p class="text-xs text-muted"><%= l departure.departs_at, format: :short %> · <%= departure.bus.name %></p></div><div class="text-right"><strong><%= departure.available_seats %> / <%= departure.capacity %> libres</strong></div></div><% end %></div></section>
  </div>
  <section class="card"><div class="card-header"><h2 class="font-black">Reservas recientes</h2></div><div class="card-body space-y-4"><% @reservations.each do |reservation| %><%= link_to reservation, class: "block border-b border-slate-100 pb-4" do %><strong><%= reservation.code %></strong><p class="text-xs text-muted"><%= reservation.departure_offer.travel_package.name %> · <%= reservation.passengers.size %> pasajero(s)</p><span class="pill pill-green mt-2"><%= reservation.status %></span><% end %><% end %></div></section>
</div>
