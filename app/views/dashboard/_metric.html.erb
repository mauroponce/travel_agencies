<article class="dashboard-kpi" aria-label="<%= label %>: <%= value %>">
  <span class="dashboard-kpi-label"><%= label %></span>
  <strong class="dashboard-kpi-value"><%= value %></strong>
  <span class="dashboard-kpi-note <%= tone %>"><%= note %></span>
  <svg class="dashboard-kpi-spark <%= tone %>" viewBox="0 0 110 32" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M0 24 C13 24 15 17 26 19 S45 23 53 15 70 19 82 10 97 13 110 5"/>
  </svg>
</article>
