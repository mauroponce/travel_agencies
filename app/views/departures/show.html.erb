<div class="page-heading"><div><div class="eyebrow">SALIDA OPERATIVA</div><h1 class="page-title"><%= @departure.code %></h1><p class="subtitle"><%= l @departure.departs_at, format: :long %> · <%= @departure.bus.name %></p></div><%= link_to "Editar", edit_departure_path(@departure), class: "btn" if current_role == 'admin' %></div><div class="metric-grid"><div class="metric"><span class="text-xs text-muted">Capacidad</span><div class="metric-number"><%= @departure.capacity %></div></div><div class="metric"><span class="text-xs text-muted">Ocupados</span><div class="metric-number"><%= @departure.occupied_seats %></div></div><div class="metric"><span class="text-xs text-muted">Disponibles</span><div class="metric-number"><%= @departure.available_seats %></div></div><div class="metric"><span class="text-xs text-muted">Ofertas</span><div class="metric-number"><%= @departure.departure_offers.count %></div></div></div>
