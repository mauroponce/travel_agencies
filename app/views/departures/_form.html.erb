<%= form_with model: departure, class: "card card-body space-y-5" do |form| %><% if departure.errors.any? %><div class="notice notice-amber"><%= departure.errors.full_messages.to_sentence %></div><% end %><div class="form-grid"><div><%= form.label :code, "Código" %><%= form.text_field :code, required: true %></div><div><%= form.label :bus_id, "Micro" %><%= form.collection_select :bus_id, current_company.buses.order(:name), :id, :name %></div><div><%= form.label :route_id, "Ruta" %><%= form.collection_select :route_id, current_company.routes.order(:name), :id, :name, include_blank: true %></div><div><%= form.label :capacity, "Capacidad" %><%= form.number_field :capacity, min: 1, required: true %></div><div><%= form.label :departs_at, "Salida" %><%= form.datetime_local_field :departs_at, required: true %></div><div><%= form.label :returns_at, "Regreso" %><%= form.datetime_local_field :returns_at %></div><div><%= form.label :status, "Estado" %><%= form.select :status, %w[draft open sold_out cancelled completed] %></div><div class="field-wide"><%= form.label :return_notes, "Información de regreso" %><%= form.text_area :return_notes %></div></div><% if departure.persisted? && departure.departure_stops.any? %><fieldset class="rounded-xl border border-line p-4"><legend class="px-2 text-sm font-black">Horarios por parada</legend><div class="form-grid"><%= form.fields_for :departure_stops do |stop_fields| %><div><%= stop_fields.label :scheduled_at, stop_fields.object.published_name %><%= stop_fields.datetime_local_field :scheduled_at, required: true %></div><% end %></div></fieldset><% end %><%= form.submit "Guardar salida", class: "btn btn-teal" %><% end %>
