<div class="page-heading"><div><div class="eyebrow">OPERACIÓN</div><h1 class="page-title">Salidas y micros</h1><p class="subtitle">La capacidad pertenece a la salida operativa y se comparte entre ofertas.</p></div><%= link_to "Nueva salida", new_departure_path, class: "btn btn-primary" if current_role == 'admin' %></div>
<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3"><% @departures.each do |departure| %><section class="card card-body"><div class="flex justify-between"><span class="pill pill-green"><%= departure.status %></span><strong><%= departure.code %></strong></div><h2 class="mt-5 text-xl font-black"><%= l departure.departs_at, format: :long %></h2><p class="mt-1 text-sm text-muted"><%= departure.bus.name %> · <%= departure.capacity %> lugares</p><div class="mt-5 text-3xl font-black"><%= departure.available_seats %> <small class="text-sm font-normal text-muted">disponibles</small></div><div class="mt-5 flex gap-2"><%= link_to "Detalle", departure, class: "btn" %><%= link_to "Hoja de ruta", operation_departure_path(departure), class: "btn btn-soft" %></div></section><% end %></div>
