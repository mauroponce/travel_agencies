<div class="page-heading"><div><div class="eyebrow">CONFIGURACIÓN OPERATIVA</div><h1 class="page-title">Catálogos</h1><p class="subtitle">Destinos, hoteles, micros, paradas y rutas reutilizables.</p></div></div>
<% if @catalog_error %><div class="notice notice-amber mb-5"><%= @catalog_error %></div><% end %>
<div class="grid gap-5 xl:grid-cols-2">
  <section class="card card-body"><h2 class="text-lg font-black">Destinos</h2><%= form_with url: catalog_path, class: "mt-4 form-grid" do |f| %><%= hidden_field_tag :kind, "destination" %><div><%= f.label :name, "Nombre" %><%= text_field_tag "destination[name]", nil, required: true %></div><div><%= f.label :province, "Provincia" %><%= text_field_tag "destination[province]" %></div><div class="field-wide"><%= f.submit "Agregar destino", class: "btn btn-primary" %></div><% end %><div class="mt-5 space-y-2"><% @destinations.each do |item| %><div class="flex justify-between rounded-xl bg-slate-50 p-3"><span><strong><%= item.name %></strong> <small class="text-muted"><%= item.province %></small></span><%= button_to "Eliminar", catalog_path(kind: "destination", record_id: item.id), method: :delete, class: "text-xs text-red-600" %></div><% end %></div></section>
  <section class="card card-body"><h2 class="text-lg font-black">Alojamientos</h2><%= form_with url: catalog_path, class: "mt-4 form-grid" do |f| %><%= hidden_field_tag :kind, "accommodation" %><div><label>Destino</label><%= select_tag "accommodation[destination_id]", options_from_collection_for_select(@destinations, :id, :name), required: true %></div><div><label>Nombre</label><%= text_field_tag "accommodation[name]", nil, required: true %></div><div><label>Categoría</label><%= text_field_tag "accommodation[category]" %></div><div><label>Dirección</label><%= text_field_tag "accommodation[address]" %></div><div><label>Google Maps</label><%= url_field_tag "accommodation[maps_url]" %></div><div><label>Sitio web</label><%= url_field_tag "accommodation[website_url]" %></div><div class="field-wide"><%= f.submit "Agregar alojamiento", class: "btn btn-primary" %></div><% end %><div class="mt-5 space-y-2"><% @accommodations.each do |item| %><div class="flex justify-between rounded-xl bg-slate-50 p-3"><span><strong><%= item.name %></strong> <small class="text-muted"><%= item.destination.name %></small></span><%= button_to "Eliminar", catalog_path(kind: "accommodation", record_id: item.id), method: :delete, class: "text-xs text-red-600" %></div><% end %></div></section>
  <section class="card card-body"><h2 class="text-lg font-black">Micros</h2><%= form_with url: catalog_path, class: "mt-4 form-grid" do |f| %><%= hidden_field_tag :kind, "bus" %><div><label>Nombre</label><%= text_field_tag "bus[name]", nil, required: true %></div><div><label>Patente</label><%= text_field_tag "bus[registration]" %></div><div><label>Capacidad</label><%= number_field_tag "bus[capacity]", 45, min: 1, required: true %></div><div><label>Transportista</label><%= text_field_tag "bus[operator_name]" %></div><div class="field-wide"><%= f.submit "Agregar micro", class: "btn btn-primary" %></div><% end %><div class="mt-5 space-y-2"><% @buses.each do |item| %><div class="flex justify-between rounded-xl bg-slate-50 p-3"><span><strong><%= item.name %></strong> · <%= item.capacity %> asientos</span><%= button_to "Eliminar", catalog_path(kind: "bus", record_id: item.id), method: :delete, class: "text-xs text-red-600" %></div><% end %></div></section>
  <section class="card card-body"><h2 class="text-lg font-black">Puntos de embarque</h2><%= form_with url: catalog_path, class: "mt-4 form-grid" do |f| %><%= hidden_field_tag :kind, "boarding_point" %><div><label>Nombre</label><%= text_field_tag "boarding_point[name]", nil, required: true %></div><div><label>Dirección</label><%= text_field_tag "boarding_point[address]", nil, required: true %></div><div class="field-wide"><%= f.submit "Agregar punto", class: "btn btn-primary" %></div><% end %><div class="mt-5 space-y-2"><% @boarding_points.each do |item| %><div class="flex justify-between rounded-xl bg-slate-50 p-3"><span><strong><%= item.name %></strong><small class="block text-muted"><%= item.address %></small></span><%= button_to "Eliminar", catalog_path(kind: "boarding_point", record_id: item.id), method: :delete, class: "text-xs text-red-600" %></div><% end %></div></section>
  <section class="card card-body xl:col-span-2"><h2 class="text-lg font-black">Rutas</h2><p class="subtitle">Las etapas pueden gestionarse desde consola/API; al crear una salida se copian como paradas publicadas.</p><%= form_with url: catalog_path, class: "mt-4 flex flex-wrap gap-3" do |f| %><%= hidden_field_tag :kind, "route" %><%= text_field_tag "route[name]", nil, required: true, placeholder: "Buenos Aires → Mendoza", class: "max-w-md" %><%= f.submit "Agregar ruta", class: "btn btn-primary" %><% end %><div class="mt-5 grid gap-3 md:grid-cols-2"><% @routes.each do |item| %><div class="rounded-xl bg-slate-50 p-4"><div class="flex justify-between"><strong><%= item.name %></strong><%= button_to "Eliminar", catalog_path(kind: "route", record_id: item.id), method: :delete, class: "text-xs text-red-600" %></div><small class="text-muted"><%= item.route_stages.map { |s| s.boarding_point&.name }.compact.join(" → ").presence || "Sin etapas" %></small></div><% end %></div></section>
</div>
