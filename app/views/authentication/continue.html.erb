<% content_for :title, "Acceso seguro" %>
<main class="access-page">
  <section class="access-card" aria-labelledby="access-title">
    <%= render "shared/brand" %>
    <span class="access-eyebrow">TU PRÓXIMO VIAJE EMPIEZA ACÁ</span>
    <h1 id="access-title">Continuar con Google</h1>
    <p class="access-description">Ingresá con tu cuenta de Google para continuar a tu espacio de Turistack.</p>
    <%= button_to "/auth/google_oauth2", method: :post, data: { turbo: false }, class: "btn btn-primary access-button" do %>
      Ingresar con Google <%= app_icon("arrow") %>
    <% end %>
    <p class="access-note">Usá la cuenta vinculada a tu espacio o creá tu perfil de agente para empezar.</p>
  </section>
</main>
