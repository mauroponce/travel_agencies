<div class="agent-heading">
  <div><span class="agent-eyebrow">REVISIÓN HUMANA</span>
    <h1>Revisá la información antes de publicar</h1>
    <p>Proveedor sugerido: <%= @item.extracted["supplier_name"].presence || "A confirmar" %></p>
  </div>
</div>
<% if @review_error %>
  <p class="agent-alert" role="alert"><%= @review_error %></p>
<% end %><% Array(@item.extracted["warnings"]).each do |warning| %>
  <p class="agent-alert"><%= warning %></p>
<% end %>
<% if @item.agent_trip %>
  <p>Esta ficha ya fue guardada.</p>
  <%= link_to "Abrir viaje", agent_trip_path(@item.agent_trip), class: "btn" %><% else %>
  <div class="agent-two-columns">
    <section class="agent-panel">
      <h2>Flyer original</h2><p>Al guardar, este flyer se conservará en el viaje y su imagen se podrá compartir al publicar.</p>
      <% if @import.preview.attached? %><%= image_tag preview_agent_import_path(@import), alt: "Vista previa del flyer", class: "agent-source-image" %><% end %>
      <% if @import.source.content_type.start_with?("image/") %><%= image_tag source_agent_import_path(@import), alt: "Flyer original privado", class: "agent-source-image" %><% else %><%= link_to "Abrir PDF original", source_agent_import_path(@import), target: "_blank", rel: "noopener", class: "btn" %><% end %>
      <dl class="agent-details"><% @item.extracted.fetch("evidence", {}).each do |field,quote| %>
          <dt><%= field %></dt>
          <dd><%= quote %></dd>
        <% end %></dl>
    </section>
    <section class="agent-panel"><%= form_with url: agent_import_item_path(@import, @item), method: :patch, scope: :agent_trip_revision, class: "agent-form", data: {controller: "agent-review"} do |f| %>
        <%= f.label :agent_supplier_id, "Empresa proveedora" %><%= f.select :agent_supplier_id, @suppliers.map { |s| [s.name,s.id] }, {include_blank: "Seleccionar empresa", selected: @revision.agent_supplier_id} %>
        <details><summary>Crear empresa sin perder la revisión</summary><%= label_tag :new_supplier_name, "Nombre de la nueva empresa" %><%= text_field_tag :new_supplier_name, params[:new_supplier_name] || @item.extracted["supplier_name"] %><button name="commit_action" value="create_supplier" class="btn">Crear empresa y conservar revisión</button></details>
        <% {title: "Título", destination: "Destino", region: "Provincia o región", price_basis: "Base del precio", hotel: "Hotel", meal_plan: "Comidas", transport: "Transporte", departure_location: "Lugar de salida"}.each do |key,label| %><%= f.label key,label %><%= f.text_field key,value: @revision.public_send(key) %><% end %><%= f.label :departs_on,"Salida" %><%= f.date_field :departs_on,value: @revision.departs_on %><%= f.label :returns_on,"Regreso" %><%= f.date_field :returns_on,value: @revision.returns_on %><%= f.label :duration_days,"Duración en días" %><%= f.number_field :duration_days,value: @revision.duration_days,min: 1 %><%= f.label :price,"Precio final del proveedor" %><%= f.text_field :price,value: @item.review_data["price"] || (@revision.price_cents && money_input_value(@revision.price_cents)),inputmode: "decimal" %><%= f.label :currency,"Moneda" %><%= f.select :currency,AgentTripRevision::CURRENCIES,{include_blank: "A confirmar",selected: @revision.currency} %><%= f.label :price_unit,"Unidad del precio" %><%= f.select :price_unit,AgentTripRevision::PRICE_UNITS.map { |key,label| [label,key] },{include_blank: "A confirmar",selected: @revision.price_unit} %><%= f.label :duration_nights, "Cantidad de noches" %><%= f.number_field :duration_nights, value: @revision.duration_nights, min: 0 %><% {description: "Descripción comercial", included_services: "Servicios incluidos",excluded_services: "Servicios excluidos",conditions: "Condiciones públicas"}.each do |key,label| %><%= f.label key,label %><%= f.text_area key,value: @revision.public_send(key) %><% end %>
        <%= label_tag :target_trip_id,"Posibles duplicados / versiones anteriores" %><select name="target_trip_id" id="target_trip_id" data-agent-review-target="trip" data-action="agent-review#select"><option value="">Crear un viaje nuevo</option><% @candidates.each do |trip| %><option value="<%= trip.id %>" data-revision="<%= trip.current_revision_id %>" <%= "selected" if params[:target_trip_id].to_s == trip.id.to_s %>><%= trip.current_revision.title %> · <%= trip.current_revision.agent_supplier.name %> · <%= trip.current_revision.departs_on %></option><% end %></select><input type="hidden" name="expected_revision_id" value="<%= params[:expected_revision_id] %>" data-agent-review-target="revision">
        <p>Elegir un viaje existente prepara una nueva revisión. Nada se reemplaza públicamente hasta publicar.</p>
        <div class="agent-actions"><button name="commit_action" value="review" class="btn">Conservar revisión</button><button name="commit_action" value="draft" class="btn">Guardar borrador</button><button name="commit_action" value="publish" class="btn btn-primary">Guardar y publicar</button></div>
      <% end %></section>
  </div>
<% end %>
