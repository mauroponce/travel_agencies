<section class="agent-public-search" aria-labelledby="agent-search-title">
  <div class="agent-search-intro">
    <span class="agent-eyebrow">ENCONTRÁ TU PRÓXIMA ESCAPADA</span>
    <h2 id="agent-search-title">¿A dónde querés viajar?</h2>
    <p>Elegí un destino y descubrí tu próximo viaje.</p>
  </div>
  <%= form_with url: agent_public_catalog_filter_url, method: :get, class: "agent-search-form destination-picker", html: { role: "search" }, data: { controller: "destination-picker", action: "click@window->destination-picker#dismiss focusout->destination-picker#blur turbo:before-cache@document->destination-picker#reset" } do |f| %>
    <%= f.hidden_field :destination, value: params[:destination], data: { destination_picker_target: "value" } %>
    <div class="agent-search-field">
      <span class="agent-search-icon" aria-hidden="true"><%= app_icon("search") %></span>
      <input type="text" id="agent-catalog-destination" role="combobox" aria-label="Destino" aria-autocomplete="list" aria-expanded="false" aria-controls="destination-options" autocomplete="off" spellcheck="false" placeholder="Buscá o elegí un destino" value="<%= params[:destination].presence || 'Todos los destinos' %>" data-destination-picker-target="input" data-action="focus->destination-picker#open input->destination-picker#filter keydown->destination-picker#navigate">
      <button type="button" class="destination-toggle" aria-label="Mostrar destinos" data-action="destination-picker#toggle"><%= app_icon("chevron-down") %></button>
    </div>
    <div class="destination-menu" data-destination-picker-target="menu" hidden>
      <div class="destination-menu-heading"><span>EXPLORÁ LOS DESTINOS</span><small>Elegí uno para ver sus viajes</small></div>
      <div id="destination-options" class="destination-options" role="listbox" aria-label="Destinos disponibles">
        <% [["Todos los destinos", ""]].concat(@destinations.map { |destination| [destination, destination] }).each_with_index do |(label, value), index| %>
          <button type="button" id="destination-option-<%= index %>" class="destination-option" role="option" tabindex="-1" aria-selected="<%= params[:destination].to_s == value %>" data-destination-picker-target="option" data-value="<%= value %>" data-label="<%= label %>" data-action="click->destination-picker#choose">
            <span class="destination-option-icon" aria-hidden="true"><%= app_icon(value.blank? ? "grid" : "route") %></span>
            <span class="destination-option-label"><%= label %></span>
            <span class="destination-option-check" aria-hidden="true">✓</span>
          </button>
        <% end %>
      </div>
      <p class="destination-status" role="status" aria-live="polite" data-destination-picker-target="status"></p>
    </div>
  <% end %>
</section>

<details class="agent-panel agent-catalog-filters"><summary>Más filtros de viajes</summary>
  <%= form_with url: agent_public_catalog_filter_url, method: :get, class: "agent-filters" do |f| %>
    <%= f.hidden_field :destination, value: params[:destination] %>
    <%= f.search_field :q, value: params[:q], placeholder: "Buscar viajes", aria: { label: "Buscar viajes" } %>
    <%= argentine_date_field(f, :from, value: params[:from], aria: { label: "Desde" }) %>
    <%= argentine_date_field(f, :to, value: params[:to], aria: { label: "Hasta" }) %>
    <%= f.select :currency, AgentTripRevision::CURRENCIES, { include_blank: "Moneda", selected: params[:currency] }, aria: { label: "Moneda" } %>
    <%= f.select :price_unit, AgentTripRevision::PRICE_UNITS.map { |key, label| [label, key] }, { include_blank: "Unidad del precio", selected: params[:price_unit] }, aria: { label: "Unidad del precio" } %>
    <%= f.number_field :max_price, value: params[:max_price], min: 0, step: "0.01", placeholder: "Precio máximo", aria: { label: "Precio máximo" } %>
    <%= f.text_field :meal_plan, value: params[:meal_plan], placeholder: "Comidas", aria: { label: "Comidas" } %>
    <%= f.text_field :transport, value: params[:transport], placeholder: "Transporte", aria: { label: "Transporte" } %>
    <%= f.select :sort, [["Fecha de salida", "date"], ["Menor precio", "price_asc"], ["Mayor precio", "price_desc"]], { selected: params[:sort] }, aria: { label: "Ordenar" } %>
    <%= f.submit "Filtrar", class: "btn btn-primary" %><%= link_to "Limpiar", agent_public_catalog_filter_url, class: "btn" %>
    <small>Para comparar precios elegí moneda y unidad.</small>
  <% end %>
</details>
