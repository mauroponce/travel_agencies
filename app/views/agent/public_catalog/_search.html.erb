<section class="search-hero agent-public-search" aria-labelledby="agent-search-title">
  <div class="hero-top"><div><span class="eyebrow">Encontrá tu próxima escapada</span><h1 id="agent-search-title">¿A dónde querés viajar?</h1><p class="subheading">Elegí un destino y descubrí tu próximo viaje.</p></div><div class="hero-aside"><span class="hero-aside-icon"><%= app_icon("spark") %></span>Tu próxima experiencia puede estar a un destino de distancia.</div></div>
  <%= form_with url: agent_public_catalog_filter_url, method: :get, id: "public-catalog-filters", class: "agent-search-form", html: { role: "search" }, data: { controller: "destination-picker", turbo_frame: "public-catalog-results", turbo_action: "replace", action: "click@window->destination-picker#dismiss focusout->destination-picker#blur submit->destination-picker#submitting turbo:before-cache@document->destination-picker#cache" } do |f| %>
    <%= f.hidden_field :destination, value: @catalog.filters["destination"], data: { destination_picker_target: "value" } %>
    <% @catalog.filters.except("destination", "destination_query", "month", "transport", "duration", "currency", "price_unit", "max_price").each do |key, value| %><%= f.hidden_field key, value: value %><% end %>
    <div class="search-line">
      <div class="search-box" data-destination-picker-target="field">
        <span class="search-icon" aria-hidden="true"><%= app_icon("search") %></span>
        <%= f.text_field :destination_query, value: @catalog.filters["destination_query"] || @catalog.filters["destination"], id: "agent-catalog-destination", role: "combobox", placeholder: "Todos los destinos", autocomplete: "off", spellcheck: false, aria: { label: "Destino", autocomplete: "list", expanded: false, controls: "destination-options" }, data: { destination_picker_target: "input", action: "focus->destination-picker#open input->destination-picker#filter compositionend->destination-picker#filter keydown->destination-picker#navigate" } %>
        <button type="button" class="search-clear" aria-label="Limpiar búsqueda" data-destination-picker-target="clear" data-action="destination-picker#clear"><%= app_icon("close") %></button>
        <button type="button" class="search-arrow" aria-label="Mostrar destinos" aria-expanded="false" data-destination-picker-target="toggle" data-action="destination-picker#toggle"><%= app_icon("chevron-down") %></button>
        <div class="suggestions" hidden data-destination-picker-target="menu">
          <div class="suggestion-label">Destinos disponibles</div>
          <div id="destination-options" role="listbox" aria-label="Destinos disponibles">
            <% [["Todos los destinos", ""]].concat(@destinations.map { |destination| [destination, destination] }).each_with_index do |(label, value), index| %>
              <button type="button" id="destination-option-<%= index %>" class="suggestion destination-option" role="option" tabindex="-1" aria-selected="<%= @catalog.filters['destination'].to_s == value %>" data-destination-picker-target="option" data-value="<%= value %>" data-label="<%= label %>" data-action="click->destination-picker#choose"><%= app_icon(value.blank? ? "grid" : "pin") %><span class="destination-option-label"><%= label %></span></button>
            <% end %>
          </div>
          <p class="suggestion-status" role="status" aria-live="polite" data-destination-picker-target="status"></p>
        </div>
      </div>
      <button type="button" class="filter-trigger" aria-controls="public-extra-filters" aria-expanded="false" data-destination-picker-target="filterToggle" data-action="destination-picker#toggleFilters"><%= app_icon("sliders") %>Más filtros <span class="filter-counter" hidden data-destination-picker-target="counter"></span></button>
    </div>
    <div id="public-extra-filters" class="filters" hidden data-destination-picker-target="filters">
      <div class="filter-field"><%= f.label :month, "Mes de salida" %><%= f.select :month, @catalog.months.map { |month| [l(month, format: "%B %Y").capitalize, month.strftime("%Y-%m")] }, { include_blank: "Todos los meses", selected: @catalog.filters["month"] }, data: { action: "change->destination-picker#apply" } %></div>
      <div class="filter-field"><%= f.label :transport, "Transporte" %><%= f.select :transport, @catalog.transports, { include_blank: "Todos", selected: @catalog.filters["transport"] }, data: { action: "change->destination-picker#apply" } %></div>
      <div class="filter-field"><%= f.label :duration, "Duración" %><%= f.select :duration, [["Hasta 4 días", "4"], ["Hasta 6 días", "6"], ["7 días o más", "7"]], { include_blank: "Cualquier duración", selected: @catalog.filters["duration"] }, data: { action: "change->destination-picker#apply" } %></div>
      <button type="button" class="reset-btn" data-action="destination-picker#clearFilters">Limpiar filtros</button>
      <details class="filters-extra"><summary>Moneda y precio</summary><div>
        <div class="filter-field"><%= f.label :currency, "Moneda" %><%= f.select :currency, AgentTripRevision::CURRENCY_LABELS.map { |code, label| [label, code] }, { include_blank: "Todas las monedas", selected: @catalog.filters["currency"] }, data: { action: "change->destination-picker#apply" } %></div>
        <div class="filter-field"><%= f.label :price_unit, "Unidad del precio" %><%= f.select :price_unit, AgentTripRevision::PRICE_UNITS.map { |key, label| [label, key] }, { include_blank: "Todas las unidades", selected: @catalog.filters["price_unit"] }, data: { action: "change->destination-picker#apply" } %></div>
        <div class="filter-field"><%= f.label :max_price, "Precio máximo" %><%= f.number_field :max_price, value: @catalog.filters["max_price"], min: 0, step: "0.01", data: { action: "change->destination-picker#apply" } %></div>
      </div></details>
    </div>
  <% end %>
</section>
