<% content_for :public_site, "true" %>
<% content_for :title, "Viajes · #{current_agent_workspace.business_name}" %>
<% content_for :stylesheets do %><%= stylesheet_link_tag "agent_public", "data-turbo-track": "reload" %><% end %>
<% content_for :head do %><meta name="description" content="Descubrí las propuestas de viajes de <%= current_agent_workspace.business_name %> y consultá por WhatsApp."><% end %>
<% workspace = current_agent_workspace; contact = "https://wa.me/#{workspace.whatsapp}" %>
<div class="advisor-site" data-controller="public-site" data-public-site-workspace-value="<%= workspace.slug %>" data-public-site-name-value="<%= workspace.business_name %>" data-action="hashchange@window->public-site#syncView">
  <header class="header">
    <div class="container header-content">
      <%= link_to workspace.show_catalog? ? "#viajes" : "#sobre-mi", class: "brand", data: { turbo: false }, aria: { label: "Inicio, viajes de #{workspace.business_name}" } do %>
        <span class="brand-mark"><%= app_icon("spark") %></span>
        <div><div class="brand-name"><%= workspace.business_name %> <span>/ Viajes</span></div><div class="brand-sub">Experiencias para tu próxima escapada</div></div>
      <% end %>
      <nav class="header-nav" aria-label="Navegación principal">
        <% if workspace.show_catalog? %><%= link_to "Viajes", "#viajes", class: "nav-item active", data: { public_site_target: "catalogLink", turbo: false } %><% end %>
        <% if workspace.show_about? %><%= link_to "Sobre mí", "#sobre-mi", class: "nav-item", data: { public_site_target: "profileLink", turbo: false } %><% end %>
      </nav>
      <%= link_to contact, class: "header-cta", target: "_blank", rel: "noopener" do %><%= app_icon("whatsapp") %>Hablemos por WhatsApp<% end %>
    </div>
  </header>
  <main>
    <% if workspace.show_catalog? %>
      <section id="viajes" class="container" data-public-site-target="catalog" aria-label="Catálogo de viajes">
        <%= render "agent/public_catalog/search" %>
        <% if @owner_view %><p class="agent-alert owner-note">Vista de agente: ves todos tus viajes, incluidos borradores, inactivos y pasados. Tus visitantes solo ven los publicados y vigentes de proveedores activos.</p><% end %>
        <%= turbo_frame_tag "public-catalog-results", target: "_top" do %>
          <%= render "agent/public_catalog/results" %>
        <% end %>
      </section>
    <% end %>
    <% if workspace.show_about? %><%= render "agent/public_catalog/profile", workspace: workspace, contact: contact %><% end %>
    <% unless workspace.show_catalog? || workspace.show_about? %>
      <div class="container empty-contact"><h1><%= workspace.public_name %></h1><p>Tu próximo viaje empieza con una conversación.</p><%= link_to "Hablemos por WhatsApp", contact, class: "dark-button", target: "_blank", rel: "noopener" %></div>
    <% end %>
  </main>
  <footer class="bottom-bar"><div class="container bottom-content">
    <div><div class="footer-copy"><%= workspace.business_name %> · Viajes · Un espacio para encontrar tu próximo destino</div><p class="demo-note">Confirmá tarifas, condiciones y disponibilidad directamente antes de contratar.</p></div>
    <nav class="footer-links" aria-label="Enlaces del pie">
      <% if workspace.show_catalog? %><%= link_to "Viajes", "#viajes", data: { turbo: false } %><% end %>
      <% if workspace.show_about? %><%= link_to "Sobre mí", "#sobre-mi", data: { turbo: false } %><% end %>
      <%= link_to "Contacto", contact, target: "_blank", rel: "noopener" %>
    </nav>
  </div></footer>
  <%= link_to contact, class: "wa-float agent-floating-whatsapp", aria: { label: "Consultar por WhatsApp" }, title: "Consultar por WhatsApp", target: "_blank", rel: "noopener" do %><%= app_icon("whatsapp") %><% end %>
</div>
