<div class="agent-heading">
  <div><span class="agent-eyebrow">IMPORTACIÓN</span>
    <h1><%= @import.source.filename %></h1>
    <p><%= agent_ai_status(@import) %></p>
  </div>
  <%= link_to "Descargar original privado", source_agent_import_path(@import, download: true), class: "btn" %></div>
<% if @duplicates.positive? %>
  <p class="agent-alert">Este archivo ya aparece en <%= @duplicates %> importación(es). Revisá los viajes existentes antes de crear duplicados.</p>
<% end %><% if %w[pending processing].include?(@import.status) %>
  <section class="agent-panel agent-loading" data-controller="agent-poll">
    <div class="agent-spinner" aria-hidden="true"></div>
    <h2><%= agent_ai_status(@import) %></h2>
    <p>Podés salir de esta pantalla y volver después. El procesamiento continúa en segundo plano.</p>
  </section>
<% elsif @import.status == "error" %>
  <section class="agent-panel">
    <h2>No pudimos procesar el archivo</h2>
    <p><%= agent_ai_error(@import.error_code) %></p>
    <%= button_to "Reintentar", retry_agent_import_path(@import), class: "btn btn-primary" %><%= link_to "Cargar viaje manualmente", new_agent_trip_path(source_import_id: @import.id), class: "btn" %></section>
<% else %>
  <section class="agent-panel">
    <h2>Revisá las fichas extraídas</h2>
    <p><%= pluralize(@import.items.size, "ficha extraída", "fichas extraídas") %>. Cada salida se revisa y se guarda por separado.</p>
    <% @import.items.each do |item| %>
      <div class="agent-row">
        <div><strong><%= item.extracted['title'].presence || "Viaje sin título" %></strong>
          <p><%= item.extracted['destination'] %> · <%= argentine_date(agent_import_departure_date(item)).presence || item.extracted['departure_text'].presence || "Fecha pendiente" %></p>
        </div>
        <% if item.agent_trip %><%= link_to "Ver viaje guardado", agent_trip_path(item.agent_trip), class: "btn" %><% else %><%= link_to "Revisar ficha", edit_agent_import_item_path(@import, item), class: "btn btn-primary" %><% end %></div>
    <% end %></section>
<% end %>
