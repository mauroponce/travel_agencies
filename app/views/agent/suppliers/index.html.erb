<div class="agent-heading">
  <div><span class="agent-eyebrow">TUS PROVEEDORES</span>
    <h1>Empresas</h1>
    <p>Trabajá con todos tus proveedores desde un único lugar.</p>
  </div>
  <%= link_to "Agregar proveedor", new_agent_supplier_path, class: "btn btn-primary" %></div>
<%= form_with url: agent_suppliers_path, method: :get, class: "agent-filters" do |f| %><%= f.search_field :q, value: params[:q], placeholder: "Buscar por proveedor o contacto", aria: { label: "Buscar proveedores" } %><%= f.submit "Buscar", class: "btn" %><% end %>
<div class="agent-grid"><% @suppliers.each do |supplier| %>
    <article class="agent-panel"><span class="agent-badge"><%= supplier.active? ? "Activo" : "Pausado" %></span>
      <h2><%= link_to supplier.name, agent_supplier_path(supplier) %></h2>
      <p><%= supplier.contact_name.presence || "Contacto pendiente" %></p>
      <p><%= supplier.phone %></p>
      <strong><%= @counts[supplier.id].to_i %> viajes cargados</strong>
      <div class="agent-actions"><%= link_to "Ver catálogo →", agent_trips_path(supplier_id: supplier.id) %></div>
    </article>
  <% end %></div>
<% if @suppliers.empty? %>
  <div class="agent-empty">
    <h2>Tu próximo proveedor empieza acá</h2>
    <p>Registrá los contactos privados de tus proveedores. No otorga acceso a ninguna empresa.</p>
  </div>
<% end %><%= render "agent/pagination", pagination: @pagination %>
