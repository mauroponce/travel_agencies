<div class="agent-heading">
  <div><span class="agent-eyebrow">EMPRESA PROVEEDORA</span>
    <h1><%= @supplier.name %></h1>
    <p><%= @supplier.active? ? "Activa" : "Pausada" %></p>
  </div>
  <%= link_to "Editar empresa", edit_agent_supplier_path(@supplier), class: "btn" %></div>
<section class="agent-panel">
  <dl class="agent-details"><% {website: "Sitio web", notes: "Notas internas", contact_name: "Contacto", phone: "Teléfono", email: "Email", commercial_terms: "Condiciones comerciales", commission_terms: "Comisión"}.each do |key, label| %>
      <dt><%= label %></dt>
      <dd><%= @supplier.public_send(key).presence || "Sin registrar" %></dd>
    <% end %></dl>
  <%= link_to "Ver viajes de esta empresa", agent_trips_path(supplier_id: @supplier.id), class: "btn btn-primary" %></section>

<%= button_to "Eliminar empresa", agent_supplier_path(@supplier), method: :delete, class: "btn", data: { turbo_confirm: "¿Eliminar esta empresa? Si tiene viajes asociados, podés pausarla." } %>
