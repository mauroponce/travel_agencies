<%= render "agent/errors", record: @supplier %><%= form_with model: @supplier, url: @supplier.persisted? ? agent_supplier_path(@supplier) : agent_suppliers_path, class: "agent-form" do |f| %><% {name: "Nombre del proveedor", contact_name: "Persona de contacto", phone: "Teléfono / WhatsApp", email: "Email"}.each do |field, label| %><%= f.label field, label %><%= f.text_field field, required: field == :name %><% end %><%= f.label :website, "Sitio web (opcional)" %><%= f.url_field :website %><%= f.label :notes, "Notas internas" %><%= f.text_area :notes %><%= f.label :commercial_terms, "Condiciones comerciales (privadas)" %><%= f.text_area :commercial_terms %><%= f.label :commission_terms, "Comisión acordada (privada)" %><%= f.text_area :commission_terms %><%= f.label :status, "Estado" %><%= f.select :status, [["Activo", "active"], ["Pausado", "paused"]] %>
  <p>Al pausar, sus viajes se ocultan de tu página. Se conservan en tu catálogo privado.</p>
  <%= f.submit "Guardar proveedor", class: "btn btn-primary" %><% end %>
