<%= form_with url: filter_url, method: :get, class: "agent-filters" do |f| %><%= f.search_field :q, value: params[:q], placeholder: "Buscar viajes", aria: { label: "Buscar viajes" } %><%= f.text_field :destination, value: params[:destination], placeholder: "Destino", aria: { label: "Destino" } %><%= f.date_field :from, value: params[:from], aria: { label: "Desde" } %><%= f.date_field :to, value: params[:to], aria: { label: "Hasta" } %>
  <%= f.select :supplier_id, @suppliers.map { |s| [s.name, s.id] }, {include_blank: "Todas las empresas", selected: params[:supplier_id]}, aria: {label: "Empresa"} %><% unless @public_view %><%= f.select :status, [["Borradores", "draft"], ["Publicados", "published"], ["Vencidos", "expired"], ["Despublicados", "unpublished"], ["Archivados", "archived"]], {include_blank: "Todos los estados", selected: params[:status]}, aria: {label: "Estado"} %><% end %>
  <%= f.select :currency, AgentTripRevision::CURRENCIES, {include_blank: "Moneda", selected: params[:currency]}, aria: {label: "Moneda"} %><%= f.select :price_unit, AgentTripRevision::PRICE_UNITS.map { |k,v| [v,k] }, {include_blank: "Unidad del precio", selected: params[:price_unit]}, aria: {label: "Unidad del precio"} %><%= f.number_field :max_price, value: params[:max_price], min: 0, step: "0.01", placeholder: "Precio máximo", aria: {label: "Precio máximo"} %><%= f.number_field :min_days, value: params[:min_days], min: 1, placeholder: "Duración mínima", aria: {label: "Duración mínima"} %><%= f.number_field :max_days, value: params[:max_days], min: 1, placeholder: "Duración máxima", aria: {label: "Duración máxima"} %><%= f.text_field :transport, value: params[:transport], placeholder: "Transporte", aria: {label: "Transporte"} %><%= f.text_field :meal_plan, value: params[:meal_plan], placeholder: "Régimen de comidas", aria: {label: "Régimen de comidas"} %><%= f.select :sort, [["Fecha de salida", "date"], ["Menor precio", "price_asc"], ["Mayor precio", "price_desc"]], {selected: params[:sort]}, aria: {label: "Ordenar"} %><%= f.hidden_field :view, value: params[:view] %><%= f.submit "Filtrar", class: "btn btn-primary" %><%= link_to "Limpiar", filter_url, class: "btn" %><small>Para filtrar u ordenar por precio, elegí moneda y unidad.</small><% end %>
