#!/usr/bin/env bash
set -euo pipefail

: "${DEPLOY_HOST:?Definí DEPLOY_HOST}"
: "${TURISTACK_IMAGE:?Definí TURISTACK_IMAGE}"
DEPLOY_USER="${DEPLOY_USER:-deploy}"
DEPLOY_PATH="${DEPLOY_PATH:-/opt/turistack}"

docker build -t "$TURISTACK_IMAGE" .
docker push "$TURISTACK_IMAGE"
ssh "$DEPLOY_USER@$DEPLOY_HOST" "cd '$DEPLOY_PATH' && docker compose -f compose.production.yml pull && docker compose -f compose.production.yml up -d --remove-orphans"
ssh "$DEPLOY_USER@$DEPLOY_HOST" "cd '$DEPLOY_PATH' && docker compose -f compose.production.yml exec -T web bin/rails runner 'puts :ok'"
