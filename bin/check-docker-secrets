#!/usr/bin/env ruby
# Run inside the copied build context, before compiling assets or shipping layers.
secret_files = Dir.glob("**/.env*", File::FNM_DOTMATCH).reject { |path| path == ".env.example" }
secret_files << "config/master.key" if File.exist?("config/master.key")
abort "Unsafe Docker context: environment secrets or master key included" if secret_files.any?
puts "Docker context: no environment secrets or master key"
